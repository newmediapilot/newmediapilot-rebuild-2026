# newmediapilot-rebuild-2026 environment
# Mirrors .env exactly. Same keys, same order, same comments.

# ---------- Site ----------
# PUBLIC_* is inlined into the client bundle by Astro. Never put a secret here.
PUBLIC_SITE_URL=https://newmediapilot.com
URL_ROOT=newmediapilot.com
URL_WWW=www.newmediapilot.com
URL_ADMIN=admin.newmediapilot.com

# Giphy key used to source the tile GIFs. Not read by the build.
# The VITE_ prefix would expose it to the browser if it ever were referenced.
VITE_GIPHY_API_KEY=

# ---------- Google Analytics ----------
# GA4 measurement ID (looks like G-XXXXXXXXXX). Analytics/admin > Data streams.
# Empty means the site ships no GA tag and no consent banner at all, so a clone
# without a property renders nothing rather than a broken tag.
PUBLIC_GA_ID=

# ---------- AWS ----------
AWS_REGION=us-east-1

# S3 bucket that serves the site
AMAZON_S3_BUCKET=

# IAM user keys with S3 / CloudFront / Lambda / SES access
NMP_AWS_ACCESS_KEY_ID=
NMP_AWS_SECRET_ACCESS_KEY=

# CloudFront distribution fronting the bucket
CLOUDFRONT_DIST_ID=

# ---------- Lambda ----------
# IAM role Lambda assumes. Required only when the function is first created.
LAMBDA_EXECUTION_ROLE_ARN=

# Printed by `npm run aws:deploy:lambda` on every deploy
PUBLIC_LAMBDA_URL=

# ---------- Contact form ----------
# Optional. The Lambda falls back to these when unset.
# CONTACT_TO=marcin@newmediapilot.com
# CONTACT_FROM=marcin@newmediapilot.com
# ALLOWED_ORIGINS=https://newmediapilot.com,https://www.newmediapilot.com
