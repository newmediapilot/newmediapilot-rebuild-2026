---
const measurementId = import.meta.env.PUBLIC_GA_ID
---

{
  // The banner and its script sit inside the same guard as the tag itself: with
  // no measurement ID there is nothing to consent to, and leaving the script
  // outside would load it on every page just to find no banner.
  measurementId && (
    <>
      <aside
        data-ident="consent-banner"
        aria-label="Cookie consent"
        hidden
        class="fixed inset-x-0 bottom-0 z-50 mx-auto max-w-2xl px-4 pb-4 sm:px-6 consent-banner"
      >
        <div class="rounded-panel bg-black/90 p-4 text-sm leading-relaxed shadow-[0_20px_40px_-20px_#000] backdrop-blur sm:p-5">
          <p class="text-white/80">
            This site uses Google Analytics to measure traffic. No tags load until you accept.
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button
              type="button"
              data-ident="consent-accept"
              class="rounded-md bg-white px-4 py-2 text-xs font-semibold uppercase tracking-widest text-black transition-colors hover:bg-white/80"
            >
              Accept
            </button>
            <button
              type="button"
              data-ident="consent-decline"
              class="rounded-md border border-white/70 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-white transition-colors hover:bg-white hover:text-black"
            >
              Decline
            </button>
          </div>
        </div>
      </aside>

      <script>
        import { readConsent, writeConsent } from './consent.js'

        const banner = document.querySelector('[data-ident="consent-banner"]')

        // Ships hidden and is only revealed here, so a returning visitor who
        // already decided never sees it flash on the way past.
        if (banner && readConsent() === null) {
          banner.hidden = false
          for (const [ident, decision] of [
            ['consent-accept', 'granted'],
            ['consent-decline', 'denied'],
          ]) {
            banner.querySelector(`[data-ident="${ident}"]`)?.addEventListener('click', () => {
              writeConsent(decision)
              banner.remove()
            })
          }
        }
      </script>
    </>
  )
}
