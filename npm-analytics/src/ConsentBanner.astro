---
const measurementId = import.meta.env.PUBLIC_GA_ID
---

{
  // The banner and its script sit inside the same guard as the tag itself: with
  // no measurement ID there is nothing to consent to, and leaving the script
  // outside would load it on every page just to find no banner.
  measurementId && (
    <>
      <aside
        data-ident="consent-banner"
        aria-label="Cookie consent"
        hidden
        class="fixed right-4 bottom-4 z-50 max-w-[17rem] consent-banner"
      >
        <div class="rounded-panel bg-black/90 p-3.5 text-sm leading-snug shadow-[0_20px_40px_-20px_#000] backdrop-blur">
          <p class="text-white/80">Can we track your visit?</p>
          <div class="mt-2 flex gap-2">
            <button
              type="button"
              data-ident="consent-accept"
              class="rounded-md bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-black transition-colors hover:bg-white/80"
            >
              Accept
            </button>
            <button
              type="button"
              data-ident="consent-decline"
              class="rounded-md border border-white/70 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-white transition-colors hover:bg-white hover:text-black"
            >
              Decline
            </button>
          </div>
        </div>
      </aside>

      <script>
        import { readConsent, writeConsent } from './consent.js'

        const banner = document.querySelector('[data-ident="consent-banner"]')

        // Ships hidden and is only revealed here, so a returning visitor who
        // already decided never sees it flash on the way past.
        if (banner && readConsent() === null) {
          banner.hidden = false
          for (const [ident, decision] of [
            ['consent-accept', 'granted'],
            ['consent-decline', 'denied'],
          ]) {
            banner.querySelector(`[data-ident="${ident}"]`)?.addEventListener('click', () => {
              writeConsent(decision)
              banner.remove()
            })
          }
        }
      </script>
    </>
  )
}
