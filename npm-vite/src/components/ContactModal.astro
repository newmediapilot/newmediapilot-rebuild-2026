---
const fields = [
  { name: 'name', label: 'Name', type: 'text', autocomplete: 'name' },
  { name: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
  { name: 'number', label: 'Number', type: 'text', autocomplete: 'tel', inputmode: 'numeric', pattern: '[0-9]*', maxlength: 25 },
]
---

<dialog
  id="contact"
  data-ident="contact-modal"
  class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-transparent p-0 backdrop:bg-black/70 backdrop:blur-3xl"
>
  <div
    data-ident="contact-modal-panel"
    data-contact-endpoint={import.meta.env.PUBLIC_LAMBDA_URL ?? ''}
    data-form-token={import.meta.env.PUBLIC_FORM_TOKEN ?? ''}
    class="page flex h-full flex-col bg-black!"
  >
    <div data-ident="contact-modal-header" class="flex items-center justify-between gap-4 py-6">
      <h2 data-ident="contact-modal-title" class="font-koho text-xl font-extrabold uppercase tracking-widest sm:text-2xl">Send a message</h2>
      <button
        type="button"
        data-ident="contact-modal-close"
        data-close-contact
        class="flex size-10 shrink-0 items-center justify-center rounded-md border border-white/70 text-white transition-colors hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        aria-label="Close"
      >
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <div data-ident="contact-modal-big-title" class="px-1 pb-2">
      <h1 class="font-koho text-4xl font-black uppercase tracking-widest sm:text-5xl md:text-6xl">CONTACT</h1>
    </div>

    <form
      id="contact-form"
      data-ident="contact-form"
      data-contact-form
      class="flex min-h-0 flex-1 flex-col gap-5 overflow-y-auto pb-6"
    >
      {
        fields.map((field) => (
          <label data-ident={`contact-field-${field.name}`} for={`contact-${field.name}`} class="block">
            <span data-ident={`contact-label-${field.name}`} class="block text-sm font-semibold uppercase tracking-widest text-white">
              {field.label}
            </span>
            <input
              required
              id={`contact-${field.name}`}
              name={field.name}
              type={field.type}
              autocomplete={field.autocomplete}
              inputmode={field.inputmode}
              pattern={field.pattern}
              maxlength={field.maxlength}
              data-ident={`contact-input-${field.name}`}
              class="mt-2 w-full border border-white/70 bg-transparent px-3 py-2.5 text-sm text-white placeholder:text-white/40 focus:border-white focus:outline-none"
            />
          </label>
        ))
      }

      <label data-ident="contact-field-message" for="contact-message" class="block">
        <span data-ident="contact-label-message" class="block text-sm font-semibold uppercase tracking-widest text-white">Message</span>
        <textarea
          required
          id="contact-message"
          name="message"
          data-ident="contact-input-message"
          rows="6"
          class="mt-2 w-full resize-y border border-white/70 bg-transparent px-3 py-2.5 text-sm text-white placeholder:text-white/40 focus:border-white focus:outline-none"
        ></textarea>
      </label>
      <!-- Honeypot. Off-screen rather than display:none / hidden, so a bot driving a
           real browser still fills it while a human never can. The Lambda answers 200
           without sending whenever this arrives non-empty. -->
      <div class="absolute -left-[9999px] top-0 h-px w-px overflow-hidden" aria-hidden="true">
        <label for="contact-website">Website</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </form>

    <!-- Kept outside the scrolling form so the button holds one fixed position
         and the status line is never pushed below the fold. -->
    <div data-ident="contact-form-actions" class="flex flex-wrap items-center justify-end gap-4 border-t border-white/15 py-4">
      <button
        type="submit"
        form="contact-form"
        data-ident="contact-submit"
        data-contact-submit
        class="rounded-md border border-white bg-white px-6 py-2.5 text-sm font-extrabold uppercase tracking-widest text-black transition-colors hover:bg-transparent hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:cursor-not-allowed disabled:opacity-50"
      >
        Send
      </button>
      <p
        data-ident="contact-status"
        data-contact-status
        data-state="idle"
        role="status"
        aria-live="polite"
        class="text-xs font-semibold uppercase tracking-widest text-white/60"
      ></p>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('contact')

  const open = () => {
    if (dialog instanceof HTMLDialogElement && !dialog.open) {
      dialog.showModal()
      requestAnimationFrame(() => {
        const nameInput = document.querySelector('[data-ident="contact-input-name"]')
        nameInput?.focus()
      })
    }
  }

  const close = () => {
    if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close()
  }

  document.addEventListener('click', (event) => {
    if (event.target.closest('[data-open-contact]')) open()
    if (event.target.closest('[data-close-contact]')) close()
  })

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) close()
  })

  const numberInput = document.querySelector('[data-ident="contact-input-number"]')

  const digitsOnly = (value) => value.replace(/\D+/g, '')

  numberInput?.addEventListener('input', (event) => {
    const input = event.currentTarget
    input.value = digitsOnly(input.value).slice(0, 25)
  })

  numberInput?.addEventListener('paste', (event) => {
    event.preventDefault()
    const pasted = event.clipboardData?.getData('text') ?? ''
    const input = event.currentTarget
    const start = input.selectionStart ?? input.value.length
    const end = input.selectionEnd ?? input.value.length
    const next = `${input.value.slice(0, start)}${digitsOnly(pasted)}${input.value.slice(end)}`.slice(0, 25)
    input.value = next
    input.setSelectionRange(next.length, next.length)
  })

  numberInput?.addEventListener('keydown', (event) => {
    if (event.key.length === 1 && !/\d/.test(event.key) && !event.ctrlKey && !event.metaKey && !event.altKey) {
      event.preventDefault()
    }
  })

  const form = document.querySelector('[data-contact-form]')
  // The action row sits outside the form so the button holds a fixed position, so
  // these two must be looked up on the dialog, not on the form.
  const status = dialog?.querySelector('[data-contact-status]')
  const submitButton = dialog?.querySelector('[data-contact-submit]')

  // Read from the DOM rather than import.meta.env on purpose. A build-time
  // constant gets folded to a literal when the var is empty, which lets the
  // minifier drop the whole fetch block and silently ship a form that cannot send.
  // Empty until the SES/Lambda backend is deployed and PUBLIC_LAMBDA_URL is set.
  const ENDPOINT =
    document.querySelector('[data-contact-endpoint]')?.getAttribute('data-contact-endpoint') ?? ''

  // Same reason as ENDPOINT: read at runtime so an empty var cannot get the whole
  // fetch block tree-shaken out of the bundle.
  const FORM_TOKEN =
    document.querySelector('[data-form-token]')?.getAttribute('data-form-token') ?? ''

  const setStatus = (state, text) => {
    if (!(status instanceof HTMLElement)) return
    status.dataset.state = state
    status.textContent = text
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()

    if (!(form instanceof HTMLFormElement)) return

    if (!form.checkValidity()) {
      form.reportValidity()
      setStatus('error', 'Fill in every field.')
      return
    }

    if (!ENDPOINT) {
      setStatus('error', 'Sending is not configured yet.')
      return
    }

    setStatus('pending', 'Sending...')
    if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true

    try {
      const payload = Object.fromEntries(new FormData(form).entries())
      const response = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-nmp-form-token': FORM_TOKEN },
        body: JSON.stringify(payload),
      })

      if (!response.ok) throw new Error(`Server responded ${response.status}`)

      setStatus('success', 'Message sent.')
      form.reset()
    } catch (error) {
      const reason = error instanceof Error ? error.message : 'Unknown error'
      setStatus('error', `Failed to send. ${reason}`)
    } finally {
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false
    }
  })
</script>

<style>
  [data-contact-status][data-state='pending'] {
    color: #fff;
  }

  [data-contact-status][data-state='success'] {
    color: #4ade80;
  }

  [data-contact-status][data-state='error'] {
    color: #f87171;
  }
</style>
