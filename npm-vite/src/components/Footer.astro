---
interface Props {
  websites?: { label: string; href: string }[]
}

const { websites = [] } = Astro.props

const brands = [
  'Labatt',
  'LG',
  'Rogers',
  'Telus',
  'Global Television',
  "McDonald's",
  'Lasenza',
  'Stella McCartney',
  'Ford',
  'Harley Davidson',
  'Loblaws',
  'Dairy Farmers of Canada',
]

const contact = [
  { label: 'marcin@newmediapilot.com', href: 'mailto:marcin@newmediapilot.com' },
  { label: '+1 416 554 6798', href: 'tel:+14165546798' },
  { label: 'Toronto, Ontario, Canada', href: '#' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/newmediapilot/' },
  { label: 'GitHub', href: 'https://github.com/newmediapilot' },
]

const pillars = [
  { ident: 'websites', heading: 'Websites', items: websites },
  { ident: 'brands', heading: 'Brands', items: brands.slice(0, 6).map((label) => ({ label })) },
  { ident: 'brands-continued', heading: '', items: brands.slice(6).map((label) => ({ label })) },
  { ident: 'contact', heading: 'Contact', items: contact },
]
---

<footer data-ident="site-footer">
  <div data-ident="footer-container" class="page py-12 shadow-[0_30px_60px_-20px_#000]">
    <table data-ident="footer-table" class="w-full table-fixed border-collapse text-left">
      <thead>
        <tr>
          {
            pillars.map((pillar) => (
              <th
                scope="col"
                data-ident={`footer-column-${pillar.ident}`}
                class="w-1/4 pb-4 align-bottom text-left text-xs font-extrabold uppercase tracking-widest"
              >
                {pillar.heading || <span class="sr-only">Brands, continued</span>}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        <tr>
          {
            pillars.map((pillar) => (
              <td data-ident={`footer-column-${pillar.ident}`} class="w-1/4 align-top">
                <ul data-ident={`footer-list-${pillar.ident}`} class="flex flex-col gap-2">
                  {pillar.items.map((item) => (
                    <li data-ident="footer-item" class="text-xs text-white sm:text-sm">
                      {item.href ? (
                        <a href={item.href} data-ident="footer-link" class="hover:underline">
                          {item.label}
                        </a>
                      ) : (
                        item.label
                      )}
                    </li>
                  ))}
                </ul>
              </td>
            ))
          }
        </tr>
      </tbody>
    </table>
  </div>
</footer>
