---
/**
 * Fullscreen gallery viewer.
 *
 * Opens when an anchor whose href starts with `#gallery-` is activated, so the
 * card links stay real, shareable URLs while the content renders in place.
 * The slug is the card's own slug, which keeps the two in sync automatically.
 *
 * `galleries` maps that same slug to the project's shots, so this component
 * stays presentational and needs to know nothing about the projects themselves.
 */
const { galleries = {} } = Astro.props;

// < is escaped so a future project name can never close the script element.
const payload = JSON.stringify(galleries).replace(/</g, '<');
---

<dialog
  id="gallery"
  data-ident="gallery-modal"
  aria-label="Image gallery"
  class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-transparent p-0 backdrop:bg-black/30 backdrop:blur-sm"
>
  {/* The panel deliberately skips the `.page` design-system class: that class
      pins a fixed height with !important at every breakpoint, which would cap
      the carousel at 400px on desktop instead of filling the modal. */}
  {/* Both the panel tint and the blur were pulled well back from the contact
      modals' heavier treatment: bg-black/50 + blur-3xl was close to opaque, so the
      page behind was barely visible and the images had nothing to sit against.
      The panel is full-bleed and covers the backdrop entirely, so these two values
      are what actually render; the dialog's own backdrop classes only matter for
      the sliver outside the panel. */}
  <div data-ident="gallery-modal-panel" class="flex h-full flex-col bg-black/30! backdrop-blur-sm py-4 sm:py-6">
    {/* The title heading is gone, so the header holds only the close button and
        justifies it to the end. The dialog carries `aria-label` instead -- the h2
        was its accessible name, and dropping it without one would leave the dialog
        unnamed. */}
    {/* pr-4/sm:pr-6 matches the panel's py-4/sm:py-6, so the close button sits the
        same distance from the right edge as the header does from the top. The panel
        is `w-full`, so the padding goes here rather than on the panel itself, which
        would otherwise narrow the track and stop slides filling a screen. */}
    <div data-ident="gallery-modal-header" class="flex shrink-0 items-center justify-end gap-4 py-2 pr-4 sm:py-4 sm:pr-6">
      <button
        type="button"
        data-ident="gallery-modal-close"
        data-close-gallery
        class="flex size-11 shrink-0 items-center justify-center rounded-md border-2 border-white text-white transition-colors hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        aria-label="Close"
      >
        <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <div data-ident="gallery-modal-body" class="flex min-h-0 flex-1 flex-col gap-4">
      <p data-ident="gallery-modal-placeholder" data-gallery-placeholder class="text-sm text-white/60">
        Gallery coming soon.
      </p>

      {/* pr-4/sm:pr-6 on the track matches the panel's py-4/sm:py-6, so the last
          slide's right edge sits the same distance from the panel edge as the header
          does from the top. It has to live on the track rather than the panel: the
          panel is `w-full`, so padding on it would narrow the track and undo the
          full-width slide sizing that makes one image fill a screen. */}
      {/* The stage is a column of two rows: the carousel (shrink-0, so it keeps its
          h-[68vh] and sits at the top) and the controls (flex-1, so they take every
          remaining pixel and centre within it).

          `justify-center` is deliberately NOT on the stage. With it, the pair was
          centred as a group, and that put the controls' midpoint at the same offset
          the flex-1 version did -- the two computed to the same pixels, so adding
          flex-1 moved nothing visible. The image has to sit at the top of the stage
          for the controls' area to become a distinct, lower region to centre in.
          `items-center` is cross-axis in a column and is kept, so the track stays
          centred horizontally. */}
      {/* `flex` is required and was missing: `flex-col` only sets flex-direction and
          does not set display, so once the script removes `hidden` this element
          became a plain block. That silently disabled flex-1, flex-col and gap-4
          together, and the controls collapsed to sitting flush against the track's
          bottom edge regardless of their classes. Everything else here assumes a
          flex column parent. */}
      <div data-ident="gallery-modal-stage" data-gallery-stage class="hidden min-h-0 flex-1 flex flex-col items-center gap-4">
        {/* `relative` is load-bearing: the script measures each slide's offsetLeft
            against the track to translate scroll position into an image index. */}
        <div
          data-ident="gallery-modal-track"
          data-gallery-track
          class="relative flex min-h-0 w-full shrink-0 snap-x snap-mandatory items-center overflow-x-auto overflow-y-hidden scroll-smooth pb-1 pr-4 scrollbar-none sm:pr-6"
          style="scrollbar-width:none"
        >
        </div>

        {/* flex-1, not shrink-0: the controls take all the space left below the
            carousel and centre themselves in it, so they sit at the vertical
            midpoint of the leftover height instead of hugging the image's bottom
            edge. The track stays shrink-0 above, which is what leaves that space
            for the controls to occupy. */}
        <div data-ident="gallery-modal-controls" class="flex min-h-0 w-full flex-1 items-center justify-center gap-6">
          <button
            data-ident="gallery-modal-prev"
            data-gallery-prev
            type="button"
            aria-label="Previous image"
            class="flex size-11 items-center justify-center rounded border-2 border-white text-white transition hover:bg-white hover:text-black disabled:opacity-40 disabled:pointer-events-none"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-6"><polyline points="15 18 9 12 15 6"/></svg>
          </button>

          <span
            data-ident="gallery-modal-counter"
            data-gallery-counter
            class="font-koho tabular-nums tracking-widest text-white/80"
            aria-live="polite"
          >1 / 1</span>

          <button
            data-ident="gallery-modal-next"
            data-gallery-next
            type="button"
            aria-label="Next image"
            class="flex size-11 items-center justify-center rounded border-2 border-white text-white transition hover:bg-white hover:text-black disabled:opacity-40 disabled:pointer-events-none"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-6"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-gallery-data set:html={payload}></script>
</dialog>

<script>
  const dialog = document.getElementById('gallery')
  const body = dialog?.querySelector('[data-gallery-modal-body]')
  const placeholder = dialog?.querySelector('[data-gallery-placeholder]')
  const stage = dialog?.querySelector('[data-gallery-stage]')
  const track = dialog?.querySelector('[data-gallery-track]')
  const counter = dialog?.querySelector('[data-gallery-counter]')
  const prevBtn = dialog?.querySelector('[data-gallery-prev]')
  const nextBtn = dialog?.querySelector('[data-gallery-next]')

  const dataElement = document.querySelector('[data-gallery-data]')
  const galleries = dataElement ? JSON.parse(dataElement.textContent) : {}

  const close = () => {
    if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close()
  }

  const slides = () => (track ? Array.from(track.children) : [])

  // Slides are laid out by the browser, so their widths differ. Measuring the
  // real offsets beats assuming a fixed slide width, which breaks the moment a
  // viewport, a gap or a max-width changes.
  const offsetOf = (slide) => slide.offsetLeft - (slides()[0]?.offsetLeft ?? 0)

  const indexFromScroll = () => {
    const list = slides()
    let closest = 0
    let closestDistance = Infinity
    list.forEach((slide, index) => {
      const distance = Math.abs(offsetOf(slide) - track.scrollLeft)
      if (distance < closestDistance) {
        closestDistance = distance
        closest = index
      }
    })
    return closest
  }

  const paint = (index) => {
    const total = slides().length
    if (counter) counter.textContent = `${index + 1} / ${total}`
    if (prevBtn) prevBtn.disabled = index <= 0
    if (nextBtn) nextBtn.disabled = index >= total - 1
  }

  const goTo = (index) => {
    const slide = slides()[index]
    if (!slide) return
    track.scrollTo({ left: offsetOf(slide), behavior: 'smooth' })
  }

  // Jumps to the first slide with no animation.
  //
  // The track carries `scroll-smooth`, and CSS `scroll-behavior: smooth` governs
  // direct `scrollLeft` assignments too, not just `scrollTo`. So assigning
  // scrollLeft = 0 while the dialog is already open (switching from one gallery
  // to another) animates the carousel backwards to the start, which reads as a
  // glitch on open. `behavior: 'instant'` is the declarative fix, but the
  // class toggle is kept as the belt-and-braces path: removing the class, forcing
  // a reflow to flush the style change, then restoring it guarantees the jump
  // lands synchronously before the first slide paints.
  const jumpToStart = () => {
    if (!track) return
    track.classList.remove('scroll-smooth')
    track.scrollLeft = 0
    void track.offsetWidth
    track.classList.add('scroll-smooth')
  }

  // Each slide is exactly as wide as the track, so `snap-center` has nothing to
  // centre and the slides need no inline padding at all -- an earlier version
  // halved the shortfall to centre narrower slides, which is now guaranteed to
  // compute 0 and would only add a phantom pixel of scroll range at the edges.
  const syncEdgePadding = () => {
    if (track) track.style.paddingInline = ''
  }

  // Paints from the scroll position in both directions, so dragging the native
  // scrollbar keeps the slider and the counter in step with the carousel.
  const settle = () => paint(indexFromScroll())

  const render = (entry) => {
    const images = Array.isArray(entry?.images) ? entry.images : []

    if (images.length === 0) {
      stage?.classList.add('hidden')
      placeholder?.classList.remove('hidden')
      if (track) {
        track.replaceChildren()
        track.style.paddingInline = ''
      }
      return
    }

    const figures = images.map((src, index) => {
            const figure = document.createElement('figure')
            // One slide per screen: w-full (not w-[100vw]) so the slide resolves
            // to the track's own content width. 100vw includes the vertical
            // scrollbar gutter, which would make every slide a few px wider than
            // the track and leave the last one unable to scroll fully into view.
            // Combined with the track's snap-mandatory, slides traverse one screen
            // at a time with no partial rest positions.
            // h-[68vh], not h-full: the track is content-sized, so a percentage
            // height here has no definite parent to resolve against and collapses
            // to the image's intrinsic pixel size.
            //
            // max-sm:scale-95 pulls the slide in on phones only, so the neighbouring
            // slide is visible at the edge and the carousel reads as separate images
            // rather than one bleeding into the next. A transform is used rather than
            // a width or padding change on purpose: scaling leaves the layout box at
            // full track width, so offsetLeft -- which the arrow buttons and the
            // counter measure against to find the current slide -- is unaffected.
            figure.className =
              'relative h-[68vh] w-full shrink-0 snap-center max-sm:scale-95'

            const image = document.createElement('img')
            image.src = src
            image.alt = `${entry.name} image ${index + 1} of ${images.length}`
            // The first slide is on screen the moment the modal opens, so it must not
            // be deferred; the rest stay lazy so opening a gallery costs one request.
            image.loading = index === 0 ? 'eager' : 'lazy'
            image.decoding = 'async'
            image.className = 'size-full object-contain'
            figure.appendChild(image)

      return figure
    })

    track?.replaceChildren(...figures)
    if (track) {
      // Padding first: slide 1 is only centred once the edge slack exists, and
      // scrollLeft 0 is what that centred position resolves to.
      syncEdgePadding()
      jumpToStart()
    }

    placeholder?.classList.add('hidden')
    stage?.classList.remove('hidden')
    paint(0)
  }

  document.addEventListener('click', (event) => {
    const closer = event.target.closest('[data-close-gallery]')
    if (closer) {
      close()
      return
    }

    // Only `#gallery-` anchors are intercepted; every other hash link keeps
    // its native behaviour.
    const link = event.target.closest('a[href^="#gallery-"]')
    if (!link) return

    event.preventDefault()

    const slug = link.getAttribute('href').slice('#gallery-'.length)
    const entry = galleries[slug]

    // Opened first on purpose: a closed <dialog> is display:none, so every
    // offsetLeft would measure as 0 and the first slide could not be located.
    if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal()

    render(entry)
  })

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) close()
  })

  let frame = 0
  track?.addEventListener(
    'scroll',
    () => {
      if (frame) return
      frame = requestAnimationFrame(() => {
        frame = 0
        settle()
      })
    },
    { passive: true }
  )

  const step = (delta) => {
    const total = slides().length
    goTo(Math.min(Math.max(indexFromScroll() + delta, 0), Math.max(total - 1, 0)))
  }

  prevBtn?.addEventListener('click', () => step(-1))
  nextBtn?.addEventListener('click', () => step(1))

  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowRight') step(1)
    if (event.key === 'ArrowLeft') step(-1)
  })

  // Re-centres on the slide the resized viewport now considers closest, so the
  // counter cannot be left describing a slide that is half off screen. The edge
  // padding is recomputed first because the slide widths are percentages, so a
  // resize changes how much slack each edge needs.
  window.addEventListener('resize', () => {
    if (dialog instanceof HTMLDialogElement && !dialog.open) return
    const index = indexFromScroll()
    syncEdgePadding()
    paint(index)
  })
</script>
