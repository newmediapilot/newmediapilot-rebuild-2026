---
interface Props {
  title?: string
  image?: string
}

const { title = 'Tile', image } = Astro.props

const background = image
  ? `background-image: url('${image}'); background-size: cover; background-position: center;`
  : 'background-color: #000000;'
---

<li class="relative aspect-square overflow-hidden p-3" style={background}>
  <span class="inline-block rounded-md bg-white px-3 py-1 text-xs font-semibold uppercase tracking-wide text-black">
    {title}
  </span>
</li>