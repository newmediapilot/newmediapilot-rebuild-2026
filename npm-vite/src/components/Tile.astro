---
interface Props {
  title?: string
  image?: string
}

const { title = 'Tile', image } = Astro.props

const background = image
  ? `background-image: url('${image}'); background-size: cover; background-position: center;`
  : 'background-color: #000000;'
---

<li class="relative aspect-square overflow-hidden bg-black p-3">
  <div
    aria-hidden="true"
    class="tile-bg pointer-events-none absolute inset-0 opacity-10 grayscale"
    style={background}
  ></div>
  <span class="relative inline-block rounded-md bg-white px-4 py-1.5 text-2xl font-extrabold uppercase tracking-widest text-black">
    {title}
  </span>
</li>