// Shuffled rather than alphabetised, so the chips don't read as a data table.
// Seeded (mulberry32) instead of Math.random() because this runs at build time:
// an unseeded shuffle would reorder the chips on every build, producing a diff
// with no source change and a different page each deploy. Change SEED to reshuffle.
const BRAND_SEED = 0x9e3779b9

const shuffledBrands = (() => {
  let s = BRAND_SEED
  const rand = () => {
    s = (s + 0x6d2b79f5) | 0
    let t = Math.imul(s ^ (s >>> 15), 1 | s)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
  const out = [...brands]
  for (let i = out.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1))
    ;[out[i], out[j]] = [out[j], out[i]]
  }
  return out
})()

const brandChipClass =
  'flex items-center justify-center rounded-md bg-black px-2.5 py-1.5 text-center leading-tight opacity-80'

// Diagonal gradient treatment per portfolio card: [angle, top, bottom]. Keyed by
// the same project `key`, so the colour travels with the card it belongs to rather
// than with a position that a reorder would break. The shared `.recent-work` rule
// in the style block reads these as --grad-angle/--grad-top/--grad-bottom.
//
// Every project needs an entry. Missing keys fall back to the shared default, which
// would leave that card on the plain gray fill, so `rows` asserts coverage below
// rather than letting a new project silently ship uncoloured.
const cardGradients = {
  wrea: ['145deg', '#1b3a4b', '#0b1a24'],
  remedy: ['115deg', '#3d1636', '#1a0b1c'],
  oakcountry: ['160deg', '#43301a', '#1d1409'],
  novo: ['125deg', '#123a34', '#07191a'],
  mazda: ['100deg', '#3a1420', '#180810'],
  klodge: ['150deg', '#16303f', '#091820'],
  homelife: ['135deg', '#1c3320', '#0a1710'],
  ccambridge: ['95deg', '#3b2a10', '#1a1206'],
  archmedia: ['170deg', '#231a44', '#0f0b20'],
  'stella-mccartney': ['120deg', '#3b2450', '#1b0f26'],
  workopolis: ['140deg', '#1a2440', '#0a0f1d'],
}

// Build-time guard: a project with no gradient would fall through to the shared
// gray default and read as a bug against its neighbours. Failing the build is
// louder and cheaper than noticing it in the browser.
const missingGradients = projects.filter((project) => !cardGradients[project.key]).map((project) => project.key)
if (missingGradients.length > 0) {
  throw new Error(`cardGradients is missing an entry for: ${missingGradients.join(', ')}`)
}

const gradStyle = (key) => {
  const [angle, top, bottom] = cardGradients[key]
  return `--grad-angle:${angle};--grad-top:${top};--grad-bottom:${bottom}`
}

// Brands & Agencies sits inside the skills grid, immediately above Front-end.
// A marker entry in the same list keeps the skill groups to a single pass.
const BRANDS_ANCHOR = 'brands'
const skillRows = skillGroups.flatMap((group) =>
  group.ident === 'front-end' ? [{ ident: BRANDS_ANCHOR }, group] : [group]
)
