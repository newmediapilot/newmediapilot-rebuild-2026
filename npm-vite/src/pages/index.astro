    note: 'Builds, packages and manages web applications',
    skills: ['Git', 'Webpack', 'Parcel', 'Gulp'],
  },
  {
    ident: 'accessibility-security',
    label: 'Accessibility, security & compliance',
    note: 'Builds accessible, secure and privacy-conscious applications',
    skills: ['WCAG', 'AODA', 'OWASP', 'Web application security', 'GDPR', 'Web privacy', 'i18n'],
  },
]

const aiDescriptions = {
  'AI agents': 'Helpers that can do multi-step work for you. They plan tasks, call tools, and keep track of progress. They act like a digital assistant in your workflow.',
  'Agentic coding': 'AI that helps write and reason about code. It can understand requirements and suggest changes. It speeds up development while you stay in control.',
  'Automation': 'Repeating tasks done automatically. It frees you from manual work and reduces errors. It’s like setting up rules your computer follows.',
  'OpenCode': 'Local coding assistant you can run on your own machine. It keeps your code private and offline. It’s open source and customizable.',
  'LM Studio': 'Run AI models locally on your computer. You can experiment without sending data online. It’s good for privacy and quick tests.',
  'Google ADK': 'Tools to build and connect AI agents. It provides building blocks for workflows and memory. It helps create reliable agent systems.',
  'OpenAI API': 'Connect to OpenAI models for text and images. It powers chat, summarization, and generation features. It integrates into apps with simple calls.',
  'Hugging Face': 'Library of open AI models and datasets. It’s a community hub for sharing models. It makes AI more accessible to developers.',
  'Local models': 'AI models that run privately on your hardware. They don’t send data to external servers. They’re ideal for sensitive work.',
  'GPT OSS': 'Open source models similar to ChatGPT. They can be customized for specific tasks. They give you control over data and training.',
  'DeepSeek': 'Open models good at reasoning and coding. They perform well on technical problems. They’re popular for developer tools.',
  'Nemotron': 'NVIDIA’s family of open AI models. They’re optimized for enterprise use cases. They support large-scale deployment.',
  'GLM': 'Open language models from Zhipu AI. They handle multilingual and reasoning tasks. They’re used in research and products.',
  'Gemma': 'Small AI models from Google for devices. They run efficiently on limited hardware. They enable on-device privacy.',
  'Prompt engineering': 'Writing good questions to get good AI answers. It’s about clarity and context. It improves reliability of AI outputs.',
};

const cmsMapping = {
  'Contentful': { authored: 'yes', integrated: 'yes', extended: 'no', url: 'https://www.contentful.com' },
  'Decap CMS': { authored: 'yes', integrated: 'yes', extended: 'yes', url: 'https://decapcms.org' },
  'WordPress': { authored: 'yes', integrated: 'yes', extended: 'yes', url: 'https://wordpress.org' },
  'TeamSite': { authored: 'yes', integrated: 'no', extended: 'no', url: 'https://www.opentext.info/teamsite/' },
  'AEM': { authored: 'no', integrated: 'yes', extended: 'no', url: 'https://business.adobe.com/products/experience-manager/adobe-experience-manager.html' },
};

const skillDescriptions = {
  'HTML': 'The basic building blocks of web pages. It structures content like headings, paragraphs, and images. Think of it as the skeleton of a site.',
  'CSS': 'Styling that makes web pages look good. It controls colors, fonts, spacing, and layout. It turns raw content into a polished design.',
  'SCSS': 'A friendlier way to write CSS with reusable styles. It lets you organize styles into modules and use variables. It makes large sites easier to maintain.',
  'Tailwind': 'A toolkit for building layouts quickly. It provides small utility classes you compose in HTML. It speeds up styling without writing custom CSS.',
  'JavaScript': 'Code that makes websites interactive. It adds behavior like buttons, forms, and animations. It brings pages to life beyond static content.',
  'TypeScript': 'JavaScript with added type checking. It helps catch mistakes before the site runs. It makes larger codebases safer to work on.',
  'GSAP': 'Smooth animations for websites. It gives fine control over motion and timing. It’s used for polished, performant effects.',
  'Service workers': 'Background helpers for offline use. They cache files so sites work without internet. They also enable push notifications.',
  'Vite': 'Fast tool for building and testing sites. It starts instantly and updates in real time. It simplifies modern front-end workflows.',
  'Node.js': 'Running JavaScript on servers. It lets the same language power back-end services. It’s widely used for APIs and tools.',
  'Express': 'Simple server setup for web apps. It provides routing and middleware for Node.js. It’s a lightweight foundation for APIs.',
  'Fastify': 'Fast server framework for APIs. It focuses on speed and low overhead. It’s great for high-performance services.',
  'PHP': 'Server language for dynamic websites. It powers many content platforms and e-commerce sites. It runs on most web hosts.',
  'ASP': 'Microsoft server technology for web apps. It integrates with Windows and .NET. It’s used for enterprise internal sites.',
  'API design': 'Planning how apps talk to each other. It defines endpoints, data shapes, and behavior. Good design makes integration reliable.',
  'User authentication': 'Checking who users are and keeping them logged in. It protects private areas and personal data. It’s essential for secure apps.',
  'Pipeline design': 'Automating build and release steps. It runs tests and deploys automatically. It reduces manual errors and speeds delivery.',
  'Socket.IO': 'Real-time messaging between browser and server. It enables chat and live updates. It works over WebSockets with fallbacks.',
  'WebSockets': 'Live two-way connection for updates. It keeps a persistent link between client and server. It’s ideal for real-time features.',
  'SQL': 'Standard language for relational databases. It lets you query and update structured data. It’s the workhorse for many business systems.',
  'NoSQL': 'Flexible databases for varied data. They handle unstructured and rapidly changing data well. They scale horizontally.',
  'MongoDB': 'Database that stores data as documents. It’s flexible and developer friendly. It’s popular for modern web apps.',
  'DynamoDB': 'Managed key-value database service. It scales automatically with traffic. It’s used for low-latency applications.',
  'SQLite': 'Small file-based database for apps. It requires no server setup. It’s great for local storage and prototypes.',
  'AWS': 'Cloud platform for hosting apps and data. It offers compute, storage, and services on demand. It scales from small to massive.',
  'Lambda': 'Run code without managing servers. It scales automatically with requests. It’s cost effective for event-driven work.',
  'S3': 'Online storage for files and media. It’s durable and globally accessible. It’s used for images, backups, and assets.',
  'CloudFront': 'Fast delivery of content worldwide. It caches sites close to users. It improves speed and reliability.',
  'Route 53': 'Domain name management and routing. It directs traffic to the right servers. It provides reliable DNS.',
  'EC2': 'Virtual computers in the cloud. You control the OS and software. It’s flexible compute for apps.',
  'Elastic Beanstalk': 'Easy deployment for web apps. It handles servers and scaling for you. It simplifies AWS launches.',
  'Load balancers': 'Spread traffic across servers. They keep sites responsive under load. They improve reliability.',
  'Lightsail': 'Simple virtual servers. It’s an easy entry to cloud hosting. It bundles compute, storage, and networking.',
  'Netlify': 'Platform for deploying websites. It offers continuous deployment from git. It’s popular for static sites.',
  'Vercel': 'Platform for frontend apps and serverless. It optimizes performance and edge delivery. It’s widely used for modern frameworks.',
  'Unix': 'Classic multi-user operating system. It powers servers and developer tools. It emphasizes simplicity and pipes.',
  'Linux': 'Open-source server operating system. It runs most of the internet. It’s customizable and stable.',
  'Git': 'Tracking changes to code over time. It lets teams collaborate safely. It supports branching and history.',
  'Webpack': 'Bundling code for the browser. It combines modules into optimized files. It’s a core build tool.',
  'Parcel': 'Zero-config bundler for quick starts. It works out of the box with modern code. It speeds up prototyping.',
  'Gulp': 'Automation for repetitive tasks. It runs scripts for build and test. It streamlines developer workflows.',
  'WCAG': 'Guidelines for accessible websites. They ensure sites work for people with disabilities. They improve usability for everyone.',
  'AODA': 'Ontario rules for digital accessibility. They require inclusive public websites. Compliance is a legal obligation.',
  'OWASP': 'Common web security risks and fixes. It provides checklists for safe development. It helps prevent breaches.',
  'Web application security': 'Keeping apps safe from attacks. It involves secure coding and monitoring. It protects user data.',
  'GDPR': 'European privacy rules for data. It governs how personal data is handled. It requires transparency and consent.',
  'Web privacy': 'Protecting user data and limiting tracking. It respects user choices and minimizes collection. It builds trust.',
  'i18n': 'Making sites work in multiple languages. It supports translation and localization. It reaches global audiences.',
};

const professional = [
  'Agency background',
  'Coordinates stand-ups',
  'Ships fast under tight deadlines',
  'Natural problem solver',
  'Clear and direct communicator',
  'Performance focused',
  'Mentors other developers',
  'Client-facing delivery',
]

const nav = [
  { label: 'Send a Message', ident: 'header-nav-send-message', trigger: 'contact' },
  { label: 'LinkedIn', ident: 'header-nav-linkedin', href: 'https://www.linkedin.com/in/newmediapilot/', blank: true },
  { label: 'GitHub', ident: 'header-nav-github', href: 'https://github.com/newmediapilot', blank: true },
  {
    label: 'Download CV',
    ident: 'header-nav-download-cv',
    href: '/uploads/Marcin%20Zajkowski%202026%20-%20Full-stack%20Front-end%20Dev.pdf',
    cta: true,
  },
]
---

<Base title="Home">
  <div id="bg-gradient" class="fixed inset-0 -z-10"></div>

  <main data-ident="site-main" class="grid grid-cols-1 gap-6 p-4 sm:gap-8 sm:p-8 site-main">
    <section data-ident="site-header" class="page rounded-panel p-8 sm:p-12 shadow-[0_20px_40px_-20px_#000] h-[36vh] site-header">
      <a
        href="/"
        data-ident="header-brand"
        class="font-koho text-4xl font-normal uppercase tracking-widest sm:text-4xl lg:text-5xl"
        >New<b class="font-bold [-webkit-text-stroke:0.6px_currentColor]">media</b><span class="font-light">Pilot</span></a
      >
      <nav data-ident="header-nav" class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          nav.map((item) =>
            item.trigger ? (
              <button
                type="button"
                data-open-contact
                data-ident={item.ident}
                class="text-xs font-semibold uppercase tracking-widest text-white transition-colors hover:text-white/70 sm:text-sm"
              >
                {item.label}
              </button>
            ) : (
              <a
                href={item.href}
                target={item.blank ? '_blank' : undefined}
                rel={item.blank ? 'noopener noreferrer' : undefined}
                data-ident={item.ident}
                class:list={[
                  'text-xs font-semibold uppercase tracking-widest text-white transition-colors sm:text-sm',
                  item.cta ? 'rounded-md border border-white/70 px-3 py-1.5 hover:bg-white hover:text-black' : 'hover:text-white/70',
                ]}
              >
                {item.label}
              </a>
            )
          )
        }
      </nav>
      <button type="button" data-open-contact-card class="mt-6 text-xs font-semibold uppercase tracking-widest text-white underline decoration-white/40 underline-offset-4 hover:decoration-white">View contact card</button>
    </section>

    <section data-ident="intro-panel" class="page rounded-panel p-8 sm:p-12 bg-transparent stripes-rust shadow-[0_20px_40px_-20px_#000] h-[36vh] intro-panel">
      <p data-ident="intro-paragraph" class="text-shadow-hard font-serif text-base leading-relaxed sm:text-lg">{intro}</p>
    </section>

    <section data-ident="professional-skills" class="page rounded-panel p-4 sm:p-6 shadow-[0_20px_40px_-20px_#000] h-[36vh] professional-skills">
      <h2 data-ident="professional-skills-heading" class="text-2xl font-extrabold sm:text-3xl professional-skills-heading">Professional Skills</h2>
      <div data-ident="professional-skills-list" class="mt-6 flex flex-wrap gap-2">
        {
          professional.map((skill) => (
            <div class="flex items-center gap-2 rounded-full border border-white/30 bg-black px-3 py-1.5 text-xs sm:text-sm professional-chip">
              <span class="size-4 rounded-full border-2 border-white/80" aria-hidden="true" />
              <span>{skill}</span>
            </div>
          ))
        }
      </div>
    </section>

    {
      skillGroups.map((group) => (
        <section data-ident={`skill-group-${group.ident}`} class="page rounded-panel p-4 sm:p-6 shadow-[0_20px_40px_-20px_#000] h-[36vh] skill-group skill-group-${group.ident}">
          <h3 data-ident={`skill-group-${group.ident}-heading`} class="font-serif text-xl font-bold text-white sm:text-2xl skill-group-heading">
            {group.label}
          </h3>
          <p data-ident={`skill-group-${group.ident}-note`} class="mt-0 -mt-1 mb-3 text-sm leading-relaxed text-white/60 sm:text-base line-clamp-2 skill-note">
            {group.note}
          </p>
          {group.ident === 'ai' ? (
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <li>
                  <div data-chip class="group relative flex cursor-pointer items-center gap-2 rounded-md border border-white/30 bg-black px-3 py-1.5 text-xs sm:text-sm skill-chip" data-note={group.note} data-desc={aiDescriptions[skill] || ''}>
                    <span>{skill}</span>
                    <button class="flex h-5 w-5 items-center justify-center rounded border border-white/20 bg-black/40 text-[10px] text-white/60 transition hover:text-white" aria-label={`More about ${skill}`}>
                      ?
                    </button>
                  </div>
                </li>
              ))}
            </ul>
            <div data-ai-message class="mt-3 hidden text-xs text-white/70"></div>
          ) : group.ident === 'frameworks' ? (
            <div class="mt-4 grid grid-cols-3 gap-3 sm:gap-4">
              {group.skills.map((skill) => {
                const iconMap = {
                  'React': 'react',
                  'Angular': 'angular',
                  'Vue': 'vuedotjs',
                  'Astro': 'astro',
                  'Symfony': 'symfony',
                  'Redux': 'redux'
                };
                const urlMap = {
                  'React': 'https://react.dev',
                  'Angular': 'https://angular.io',
                  'Vue': 'https://vuejs.org',
                  'Astro': 'https://astro.build',
                  'Symfony': 'https://symfony.com',
                  'Redux': 'https://redux.js.org'
                };
                const icon = iconMap[skill] || 'react';
                const url = urlMap[skill] || '#';
                return (
                  <a href={url} target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center justify-center rounded-md border border-white/30 bg-black p-3 text-center transition duration-200 hover:bg-black/80 hover:border-white/60">
                    <img src={`https://cdn.simpleicons.org/${icon}/ffffff`} alt={skill} class="mb-2 h-8 w-8 sm:h-10 sm:w-10 transition-transform duration-200 group-hover:scale-110" />
                    <span class="text-[10px] sm:text-xs">{skill}</span>
                  </a>
                );
              })}
            </div>
          ) : group.ident === 'cms' ? (
            <div class="mt-2 overflow-auto">
              <table class="w-full table-fixed border-collapse text-[11px] sm:text-xs">
                <thead>
                  <tr class="border-b border-white/20">
                    <th class="p-1.5 font-semibold uppercase tracking-wider text-left">System</th>
                    <th class="p-1.5 font-semibold uppercase tracking-wider text-center">Authored</th>
                    <th class="p-1.5 font-semibold uppercase tracking-wider text-center">Integrated</th>
                    <th class="p-1.5 font-semibold uppercase tracking-wider text-center">Extended</th>
                  </tr>
                </thead>
                <tbody>
                  {group.skills.map((skill) => {
                    const row = cmsMapping[skill] || { authored: '—', integrated: '—', extended: '—', url: '' };
                    const Icon = (val) => val === 'yes' ? '✓' : val === 'no' ? '✗' : '—';
                    return (
                      <tr class="border-b border-white/10">
                        <td class="p-1.5 align-top text-left">
                          {row.url ? <a href={row.url} target="_blank" rel="noopener noreferrer" class="hover:underline">{skill}</a> : skill}
                        </td>
                        <td class="p-1.5 align-top text-center">{Icon(row.authored)}</td>
                        <td class="p-1.5 align-top text-center">{Icon(row.integrated)}</td>
                        <td class="p-1.5 align-top text-center">{Icon(row.extended)}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <li>
                  <div data-chip class="group relative flex cursor-pointer items-center gap-2 rounded-md border border-white/30 bg-black px-3 py-1.5 text-xs sm:text-sm skill-chip" data-note={group.note} data-desc={skillDescriptions[skill] || ''}>
                    <span>{skill}</span>
                    <button class="flex h-5 w-5 items-center justify-center rounded border border-white/20 bg-black/40 text-[10px] text-white/60 transition hover:text-white" aria-label={`More about ${skill}`}>
                      ?
                    </button>
                  </div>
                </li>
              ))}
            </ul>
            <div data-ai-message class="mt-3 hidden text-xs text-white/70"></div>
          )}
        </section>
      ))
    }

    {
      rows.map((row) => (
        <section data-ident={`recent-work-${slug(row.name)}`} class="page rounded-panel p-4 sm:p-6 shadow-[0_20px_40px_-20px_#000] h-[36vh] grid grid-cols-[1fr_1fr] gap-4 items-stretch overflow-hidden recent-work">
          <div class="overflow-hidden rounded-lg">
            <Image src={row.image} alt={row.alt} class="h-full w-full object-cover scale-[1.08]" style={`object-position: ${row.position}`} />
          </div>
          <div class="flex flex-col justify-start">
            <h3 class="font-serif text-lg sm:text-xl">{row.name}</h3>
            <p class="mt-2 text-xs text-white/70 sm:text-sm">Ongoing client work with focus on performance and content systems.</p>
            <div class="mt-3 flex flex-col items-start gap-2 text-sm">
              <button class="flex items-center gap-2 underline decoration-white/40 underline-offset-4 hover:decoration-white">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                View gallery
              </button>
              {row.href && row.href !== '#' && (
                <a href={row.href} target="_blank" rel="noopener" class="flex items-center gap-2 underline decoration-white/40 underline-offset-4 hover:decoration-white">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Launch website
                </a>
              )}
              {recentWebsiteLabels.has(row.name) && (
                <a href={websiteUrlMap[row.name] || '#'} target="_blank" rel="noopener" class="flex items-center gap-2 underline decoration-white/40 underline-offset-4 hover:decoration-white">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Visit website
                </a>
              )}
            </div>
          </div>
        </section>
      ))
    }

    <section data-ident="footer-websites" class="page rounded-panel p-4 sm:p-6 shadow-[0_20px_40px_-20px_#000] h-[36vh]" footer-websites">
      <h3 class="font-serif text-xl font-bold text-white sm:text-2xl">Recent Websites</h3>
      <ul class="mt-4 flex flex-col gap-2 text-sm">
        {websites.map((w) => (
