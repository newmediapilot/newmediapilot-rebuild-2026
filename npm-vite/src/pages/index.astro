  <style>
    .skill-chip.active { background-color: white !important; color: black; border-color: black; filter: brightness(1.15); }
    .skill-chip.active button { background-color: black; color: white; border-color: black; }
    main > section:nth-child(n+3) { font-size: 0.9em; }
    .page h2, .page h3 { text-transform: capitalize; }
    .skill-chip:not(.active) span { opacity: 0.6; }
    .professional-skills-heading { font-family: 'KoHo', serif; font-weight: 700; letter-spacing: 0.02em; }
    .skill-group-heading { font-size: 1.6em; }
    .skill-note { margin-bottom: 0.75rem !important; min-height: 2.75rem; }    .skill-group { position: relative; overflow: hidden; }
    .professional-chip span:first-child { transition: transform 300ms ease; display: inline-block; }
    .professional-chip:hover span:first-child { transform: rotate(180deg); }
    .skill-group > * { position: relative; z-index: 1; }
    /* No blanket `background: transparent !important` here any more. It was a
       shorthand, so on .site-header and .skill-group it reset background-image and
       silently discarded the shared gradient below -- which is why those panels kept
       rendering flat grey no matter what colours were set on them. */

    /* Shared card gradient. Two things stacked:
         1. Two off-centre radial blobs in the card's own --grad-top and --grad-mid,
            each fading to transparent. These are what stop every card reading as a
            flat vertical or horizontal ramp -- a linear gradient alone can only ever
            be a straight line through the box, no matter the angle, so organic
            shapes have to come from radials.
         2. The three-stop linear underneath, which supplies the base wash and keeps
            the corners from going flat where the blobs do not reach.
       Blob centres come from --blob-a / --blob-b so each card can place them
       differently; they are emitted per card by gradStyle, and the fallbacks here
       keep an unconfigured card from losing its fill. The white grid in ::after is
       still a separate layer and composites on top unchanged.
       Every stop stays dark because that pattern is white at 25% alpha and would
       vanish against anything lighter.
       Deliberately one class of specificity: .skill-group.stripes-panel below is
       two, so CMS and Web Frameworks keep their stripes regardless of source order. */
    .site-header,
    .professional-skills,
    .skill-group,
    .footer-brands,
    .recent-work,
    .footer-websites {
      background-image:
        radial-gradient(
          58% 66% at var(--blob-a, 18% 22%),
          var(--grad-top, #1a1a24),
          transparent 72%
        ),
        radial-gradient(
          48% 58% at var(--blob-b, 82% 30%),
          var(--grad-mid, #1a1a24),
          transparent 68%
        ),
        radial-gradient(74% 82% at 76% 88%, var(--grad-bottom, #1a1a24), transparent 74%),
        linear-gradient(
          var(--grad-angle, to top),
          var(--grad-bottom, #1a1a24),
          var(--grad-mid, var(--grad-top, #1a1a24)),
          var(--grad-top, #1a1a24)
        ) !important;
    }
    /* The skill groups are all one class, so nothing distinguishes them without this.
       Alternating the blob centres on sibling parity keeps the panels from sharing
       an identical shape while staying a single rule rather than nine declarations. */
    .skill-group:nth-of-type(even) {
      --blob-a: 78% 26%;
      --blob-b: 20% 34%;
    }
    .skill-group:nth-of-type(odd) {
      --blob-a: 24% 18%;
      --blob-b: 74% 38%;
    }
    /* The intro panel is deliberately absent from that list. It takes its colour
       from `.stripes-rust` in global.css, and a `background-image` here would
       replace the stripes rather than sit under them -- the same trap
       .skill-group.stripes-panel below is written to avoid. Its rust stripes are
       already its colour, so it needs no gradient. */

    /* One hue per card, deep and desaturated. Professional Skills keeps the
       orange-to-purple it already had. The site header gets a warm brown so it is
       no longer plain black behind its band pattern. */
    /* Mid stops mirror the table above, so these two sources cannot drift: a card
       coloured in the frontmatter and the same card coloured here get the same
       three-stop gradient. */
    .site-header { --grad-top: #4a1f0a; --grad-mid: #33190d; --grad-bottom: #160a05; }
    .professional-skills { --grad-top: #241640; --grad-mid: #6b2a12; --grad-bottom: #3a1608; }
    .skill-group-ai { --grad-top: #0d3540; --grad-mid: #123a2a; --grad-bottom: #071a1f; }
    .skill-group-front-end { --grad-top: #2a1c56; --grad-mid: #1c2a3a; --grad-bottom: #180f33; }
    .skill-group-back-end { --grad-top: #4a2418; --grad-mid: #3a1c2a; --grad-bottom: #2a120b; }
    .skill-group-databases { --grad-top: #4a3410; --grad-mid: #2a3418; --grad-bottom: #2a1d08; }
    .skill-group-cloud { --grad-top: #1d2b3c; --grad-mid: #16283a; --grad-bottom: #101823; }
    .skill-group-build { --grad-top: #33400f; --grad-mid: #2a2a1a; --grad-bottom: #1c2408; }
    .skill-group-accessibility-security { --grad-top: #4c1a28; --grad-mid: #2a1a3a; --grad-bottom: #2b0d15; }
    .footer-brands { --grad-top: #54240f; --grad-mid: #301309; --grad-bottom: #1a0a05; }
    .footer-websites { --grad-top: #241640; --grad-mid: #161620; --grad-bottom: #0c0c14; }

    @media (max-height: 360px) and (orientation: landscape) {
      .site-header {
        min-height: 90vh !important;
      }
    }

    /* These panels carry the paragraph panel's stripe texture, but the blanket
       `background: transparent !important` above would wipe it out -- same
       specificity, and the important flag wins. Restated here with both halves of
       the shorthand and the same !important, declared after, so it takes. */
    .skill-group.stripes-panel {
      background-color: var(--stripe-a) !important;
      background-image: var(--stripes-image) !important;
    }
    /* CMS and Web Frameworks keep only their stripes plus the shared ::after
       hatch, which is what the paragraph panel already does. */
    .site-header {
      --sz: 20px;
      --c0: #ffffff00;
      --c1: #0a0a0a;
      --c2: #111111;
      --c3: #050505;
      --ts: 50%/ calc(var(--sz) * 13.25) calc(var(--sz) * 11.7);
      position: relative;
      overflow: hidden;
    }

    .site-header::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        repeating-conic-gradient(#3b354730 0.000001%, var(--c0) 0.00005%, var(--c0) 0.00035%, var(--c0) 0.00005%) var(--ts),
        repeating-conic-gradient(#35638b59 0.00002%, var(--c0) 0.00008%, var(--c0) 0.0008%, var(--c0) 0.00008%) var(--ts),
        repeating-linear-gradient(90deg, var(--c0) 0 24.33%, var(--c3) 0 25%) var(--ts),
        linear-gradient(210deg, var(--c0) 0 80%, var(--c3) calc(80% + 1px) 80.5%, var(--c0) calc(80.5% + 1px) 100%) var(--ts),
        conic-gradient(from -90deg at 49.75% 100%, var(--c1) 0 30deg, var(--c0) 0 150deg, var(--c2) 0 60deg) var(--ts),
        conic-gradient(from -180deg at 24.5% 50.5%, var(--c1) 0 119deg, var(--c0) 0 100%) var(--ts),
        conic-gradient(from 120deg at 74.5% 50%, var(--c3) 0 120deg, var(--c0) 0 100%) var(--ts),
        conic-gradient(from 180deg at 49.5% 34%, var(--c2) 0 60deg, var(--c0) 0 100%) var(--ts),
        conic-gradient(from -120deg at 50% 34%, var(--c3) 0 60deg, var(--c0) 0 100%) var(--ts),
        conic-gradient(from 0deg at 74.5% 17.5%, var(--c2) 0 60deg, var(--c3) 0 121deg, var(--c0) 0 100%) var(--ts),
        linear-gradient(150deg, var(--c0) 0 40%, var(--c3) calc(40% + 1px) 40.5%, var(--c0) calc(40.5% + 1px) 100%) var(--ts),
        linear-gradient(90deg, var(--c0) 0 50%, var(--c2) 0 75%, var(--c0) 0 100%) var(--ts),
        repeating-linear-gradient(90deg, var(--c1) 0 24.33%, var(--c3) 0 25%) var(--ts);
      z-index: 0;
      animation: header-pattern-drift 120s linear infinite;
    }

    @keyframes header-pattern-drift {
      from { background-position: 0 0; }
      to { background-position: 0 264px; }
    }
    .site-header > * { position: relative; z-index: 1; }

    /* Two-class selector on purpose: `.site-header > *` above is the same
       specificity as a bare `.header-slogan` and would win on source order,
       resetting this back to `position: relative` and dropping the slogan into
       the flow under the nav. */
    .site-header .header-slogan {
      position: absolute;
      /* Matches the card's p-8 / sm:p-12, so the slogan sits on the card's own
         margin instead of hard against the edge. */
      right: 2rem;
      bottom: 2rem;
      margin: 0;
      /* Wider on phones so the shorter type still fits on fewer lines, rather than
         wrapping to a tall block against the stacked nav. */
      max-width: 70%;
      text-align: right;
      color: #fff;
      /* Arial Black is a system face, not one of the two Google fonts this site
         loads (KoHo, Playfair Display), so it cannot be requested by name the way
         KoHo is. The stack degrades to Arial Bold and then Arial; on a platform
         with neither it lands on the generic sans-serif and loses the heavy
         weight. Say so if you would rather I load Anton or Archivo Black from
         Google Fonts to guarantee it everywhere. */
      font-family: 'Arial Black', 'Arial Bold', Arial, Helvetica, sans-serif;
      font-weight: 900;
      /* Smaller on phones. The header card is a fixed 36vh and the nav stacks into
         a column below 640px, so a 14px slogan wrapped against a 55% max-width was
         eating three or four lines of that column and crowding the CV link. */
      font-size: 11px;
      line-height: 1.1;
      opacity: 0.8;
      /* The card scrolls horizontally on touch; a pointer-events:none slogan would
         otherwise become a scroll trap mid-gesture. */
      pointer-events: none;
      z-index: 2;
    }
    @media (min-width: 640px) {
      .site-header .header-slogan {
        right: 3rem;
        bottom: 3rem;
        font-size: 14px;
        max-width: 55%;
      }
    }

    /* The little grid, now on every card so none reads as an empty gradient.
       --grid-alpha is the single dial: 0.25 everywhere by default, dropped to 0.15
       on the skill-group and Professional Skills panels below, which are smaller and
       sit on lighter tones where 0.25 was strong enough to read as static. The
       already-coloured cards keep 0.25 untouched.
       --grid-opacity is separate from the alpha so the layer can be faded without
       editing the gradient stops. pointer-events:none keeps the overlay from
       swallowing the chip hovers on the professional-skills panel. */
    .site-header::after,
    .intro-panel::after,
    .professional-skills::after,
    .skill-group::after,
    .footer-brands::after,
    .recent-work::after,
    .footer-websites::after {
      /* One shared pattern for every card, the -45deg / 4px tile. Kept in the base
         block rather than repeated per card so the cards cannot drift apart again. */
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: var(--grid-opacity, 0.5);
      background-repeat: repeat;
    }
    .site-header::after,
    .intro-panel::after,
    .professional-skills::after,
    .skill-group::after,
    .footer-brands::after,
    .recent-work::after,
    .footer-websites::after {
      background-image: repeating-linear-gradient(-45deg, rgba(255,255,255,var(--grid-alpha, 0.25)), rgba(255,255,255,var(--grid-alpha, 0.25)) 1px, transparent 1px, transparent 6px);
      background-size: 4px 4px;
    }
    .professional-skills,
    .skill-group { --grid-alpha: 0.15; }

    /* Positioning for the grid layer. `inset: 0` on an absolutely positioned ::after
       resolves against the nearest positioned ancestor, so every card that carries a
       ::after has to be one itself or the grid lands on the wrong box. .skill-group
       and .site-header already declared position:relative for their own overlays;
       .intro-panel and .footer-websites are declared here. The `> *` rules lift the
       content above the grid, which sits at z-index 0. */
    .intro-panel { position: relative; }
    .footer-websites { position: relative; overflow: hidden; }
    .intro-panel > * { position: relative; z-index: 1; }

    .professional-skills {
      --sz: 20px;
      --c0: #ffffff00;
      --c1: #0a0a0a;
      --c2: #111111;
      --c3: #050505;
      --ts: 50%/ calc(var(--sz) * 13.25) calc(var(--sz) * 11.7);
      position: relative;
      overflow: hidden;
    }
    .professional-skills > * { position: relative; z-index: 1; }
    .page { min-height: 335px; }
    section.page.skill-group, section.page.professional-skills { min-height: 360px; }
    @media (min-width: 1201px) {
      .page { height: 400px !important; min-height: 400px !important; }
    }
    @media (min-width: 769px) and (max-width: 1200px) {
      .page { height: 500px !important; min-height: 500px !important; }
    }
    /* Below the two-column breakpoint every panel is free to size to its own
       content, so a card with three links is not padded out to match one with a
       single gallery link. The fixed heights above only apply once the grid is
       actually laying cards out side by side. */
    @media (max-width: 900px) {
      .page { height: auto !important; min-height: 0 !important; }
    }
    @media (max-width: 640px) {
      [data-ident="header-brand"] .brand-word { display: block; line-height: 1.1; }
      [data-ident="header-nav"] { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
      [data-ident="header-nav-download-cv"] { margin-top: 1rem; }
    }
    .skill-chip {
      background: transparent !important;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    main.site-main { grid-template-columns: repeat(3, minmax(0,1fr)) !important; }
    @media (max-width: 1600px) {
      main.site-main { grid-template-columns: repeat(2, minmax(0,1fr)) !important; }
    }
    @media (max-width: 900px) {
      main.site-main { grid-template-columns: repeat(1, minmax(0,1fr)) !important; }
    }
    /* Text is decorative, so selection is suppressed site-wide. Form fields opt
       back in, otherwise typing and correcting text in the contact form breaks. */
    body {
      user-select: none;
      -webkit-user-select: none;
    }
    input,
    textarea,
    [contenteditable] {
      user-select: text;
      -webkit-user-select: text;
    }
  
    .professional-skills .size-4 {
      border-style: dotted;
      display: inline-block;
      animation: spin-slow 90s linear infinite;
      /* Resting spin is slow enough to read as a drift, so the jump to the fast
         loop is a clear signal rather than a subtle change. */
      transition: animation-duration 180ms ease;
    }
    /* Only the duration is swapped, never the animation shorthand: rewriting the
       shorthand would reset `infinite` and the loop would stop on mouse-out. */
    .professional-chip:hover .size-4 {
      animation-duration: 1.8s;
    }
    @keyframes spin-slow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .recent-work {
      position: relative;
      overflow: hidden;
      /* Was `background: transparent !important`, a shorthand that also reset
         background-image and so wiped the portfolio gradients. Declared as a
         longhand so the shared gradient rule survives, and left without !important
         because [data-ident] on this selector already outranks the gradient rule's
         single class -- an !important shorthand here would beat it outright. */
    }
    .recent-work > * {
      position: relative;
      z-index: 1;
    }

    /* The image cell is stretched by the grid, so its width and height are both
       known. Sizing from min(100cqw, 100cqh) keeps the card exactly 1:1 at every
       viewport -- a plain aspect-ratio + max-width clamp collapses into a
       portrait box (and crops the image) once the column is narrower than tall. */
    /* Framework tile hover backdrop. The GIF is declared only on :hover so the
       browser fetches ~6MB of animation on first hover instead of on page load.
       brightness and opacity compound against the black tile, so both have to stay
       well above zero or the result is invisible. */
    .framework-tile::before {
      content: "";
      position: absolute;
      inset: 0;
      background-position: center;
      background-size: cover;
      filter: grayscale(1) brightness(0.6) contrast(1.1);
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    .framework-tile:hover::before {
      background-image: var(--tile-gif);
      opacity: 0.5;
    }

    /* Follows the glyph's alpha shape, so unlike box-shadow it does not draw a
       rectangle. Sits under the icon and reads once the hover backdrop lifts. */
    .framework-logo {
      filter: drop-shadow(0 6px 5px rgba(0, 0, 0, 1)) drop-shadow(0 3px 2px rgba(0, 0, 0, 0.95)) drop-shadow(0 1px 0 rgba(0, 0, 0, 0.9));
    }

    .card-figure {
      container-type: size;
    }
    .card-image {
      width: min(100cqw, 100cqh);
      height: min(100cqw, 100cqh);
      flex: none;
      /* Positive offsets keep the inset shadow on the inner top-left edges only.
         Reads stronger on hover, when the brightness filter lifts. */
      box-shadow: inset 6px 6px 14px rgba(0, 0, 0, 0.45);
    }
    /* Stacked cards have no grid cell to stretch, so there is no resolved block
       size for a `size` container to measure against. Switching to `inline-size`
       derives the square from the column width alone, which is stable once the
       height comes from content. */
    @media (max-width: 900px) {
      .card-figure { container-type: inline-size; }
      .card-image { width: 100cqw; height: 100cqw; }
    }

    /* The chips are plain divs with no role or tabindex, so none of the pointer
       selectors in global.css match them. Declared here instead of adding a role,
       since they carry no action for a pointer to promise. */
    /* The chip is the positioning context: the gradient lives on a ::before
       pinned to its padding box, so it sits behind the dot and the label without
       needing to know their sizes. Those two then lift above it with z-index. */
    .professional-chip {
      transition: border-color 0.2s ease;
      cursor: pointer;
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    /* 45deg gives the diagonal banding. The bands alternate between two tones and
       slide sideways, which only reads as movement because background-size is
       wider than the box -- at 100% a translated background would simply clip. */
    .professional-chip::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      opacity: 0;
      background-image: repeating-linear-gradient(
        135deg,
        rgba(191, 77, 40, 0.75) 0px,
        rgba(191, 77, 40, 0.75) 14px,
        rgba(122, 49, 20, 0.75) 14px,
        rgba(122, 49, 20, 0.75) 28px
      );
      background-size: 300% 300%;
      background-position: 100% 50%;
      /* Fast out. The hover rule below overrides this with the slower duration,
         so the easing can differ per direction without a second element. */
      transition: opacity 120ms ease-out;
    }
    .professional-chip:hover::before,
    .professional-chip:focus-visible::before {
      opacity: 1;
      /* Long cycle: the gradient drifts rather than visibly scrolls. */
      animation: chip-gradient-slide 9s linear infinite;
      transition: opacity 300ms ease-in;
    }
    /* Isolated on ::before so the moving gradient cannot re-trigger the reveal
       transition on every repaint. Runs right-to-left to match the reading
       direction of the keyframe, so the banding travels back the other way. */
    @keyframes chip-gradient-slide {
      from { background-position: 100% 50%; }
      to   { background-position: 0% 50%; }
    }
    /* The label sits over a moving gradient, so it takes the same hard black
       shadow the intro paragraph uses to stay readable. */
    .professional-chip > span:not(:first-child) {
      position: relative;
      z-index: 1;
      text-shadow: 2px 2px 0 #000;
    }
    .professional-chip > span:first-child {
      position: relative;
      z-index: 1;
    }
    /* Reduced motion: keep the reveal, drop the slide. A looping background
       animation is exactly the kind of large-area motion this setting targets. */
    @media (prefers-reduced-motion: reduce) {
      .professional-chip:hover::before,
      .professional-chip:focus-visible::before {
        animation: none;
      }
    }
    .professional-chip:hover {
      border-color: rgba(255,255,255,0.6);
    }
    .skill-chip { transition: border-color 0.2s ease; }
    .skill-chip:hover {
      border-color: rgba(255,255,255,0.6);
    }
    /* The filter transition the cards need for the hover saturation bump, and the
       one the header needs for its nav hue-shift, are the same declaration and now
       live in the shared card rule above rather than twice. */
    /* Set by the entrance script while the cards are tweening. Kills the filter
       transition so GSAP owns the property outright; without it the 0.3s ease
       overrides the tween and the card jumps to its final value. */
    .cards-entering,
    .cards-entering * {
      transition: none !important;
    }
    /* Hover saturates the whole card by 10%. Filter rather than a colour change on
       the gradient stops, because the stops are custom properties shared by every
       card that reuses the ident -- animating them would have to be done per card
       and would fight the `!important` background-image above.
       Transition is what makes it smooth; `.cards-entering` kills it for the length
       of the entrance so the two do not fight over `filter`.
       Safe on the containing-block front: filter establishes one, so anything
       position:fixed inside a card would be pinned to it while hovered. The gallery,
       contact and contact-card dialogs are all siblings of <main> rather than card
       descendants, and the only fixed element on the page (#cursor-ball) is a
       sibling of main too, so nothing is affected. */
    .site-header,
    .intro-panel,
    .professional-skills,
    .skill-group,
    .footer-brands,
    .recent-work,
    .footer-websites {
      transition: filter 0.3s ease;
    }
    .site-header:hover,
    .intro-panel:hover,
    .professional-skills:hover,
    .skill-group:hover,
    .footer-brands:hover,
    .recent-work:hover,
    .footer-websites:hover {
      filter: saturate(1.1);
    }
    /* Nav children: 1 = button, 2 = LinkedIn, 3 = GitHub, 4 = Download CV.
       saturate() is repeated in each because filter is a single value, not additive:
       a more specific :hover rule replaces the earlier one outright rather than
       combining with it, so the header's own saturation bump would be dropped the
       moment a nav link was hovered. */
    .site-header:has(nav a:nth-child(2):hover) {
      filter: hue-rotate(10deg) saturate(1.1);
    }
    .site-header:has(nav a:nth-child(3):hover) {
      filter: hue-rotate(20deg) saturate(1.1);
    }
    .site-header:has(nav a:nth-child(4):hover) {
      filter: hue-rotate(30deg) saturate(1.1);
    }
    /* pointer-events was disabled on the whole panel, which suppressed :hover on
       every chip inside it -- no border flash, no fast spin, no pointer cursor,
       since hover never reached them. Restored so the chip hovers work. */
    .is-hover-locked {
      filter: brightness(1.3) saturate(1.2);
      outline: 2px solid rgba(255,255,255,0.6);
      outline-offset: 2px;
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    /* Static grid: the design-system .page forces a fixed 400/500px height, which
       would leave dead space under the list. Declared after that rule so it wins
       on equal specificity. */
    .footer-brands {
      height: auto !important;
      min-height: 0 !important;
      position: relative;
      overflow: hidden;
      /* Longhand for the same reason as .recent-work: the shorthand was resetting
         background-image and clearing this card's gradient too. */
    }
    .footer-brands > * { position: relative; z-index: 1; }
    #cursor-ball {
      position: fixed;
      left: 0;
      top: 0;
      width: 360vw;
      height: 360vh;
      pointer-events: none;
      mix-blend-mode: soft-light;
      background: radial-gradient(circle, rgba(255,255,255,0.35) 0%, rgba(255,255,255,0) 70%);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      z-index: 9999;
    }
</style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const chips = document.querySelectorAll('[data-chip]');
      chips.forEach(chip => {
        chip.addEventListener('click', (e) => {
          e.stopPropagation();
          const section = chip.closest('section');
          const allChips = section.querySelectorAll('[data-chip]');
          allChips.forEach(c => c.classList.remove('active'));
          const isChecked = chip.classList.contains('inverted');
          const btn = chip.querySelector('button');
          const messageEl = section.querySelector('[data-ai-message]');
          if (messageEl && messageEl._typingTimeout) {
            clearTimeout(messageEl._typingTimeout);
            delete messageEl._typingTimeout;
          }
          if (isChecked) {
            chip.classList.remove('inverted');
            if (btn) btn.textContent = '?';
            if (messageEl) { messageEl.classList.add('hidden'); messageEl.textContent = ''; }
          } else {
            chip.classList.add('inverted');
            chip.classList.add('active');
            if (btn) btn.textContent = '✓';
            if (messageEl) {
              messageEl.classList.remove('hidden');
              const desc = chip.dataset.desc || chip.dataset.note || '';
              let i = 0;
              messageEl.textContent = '';
              const speed = 18;
              const type = () => {
                if (i <= desc.length) {
                  messageEl.textContent = desc.slice(0, i);
                  i++;
                  messageEl._typingTimeout = setTimeout(type, speed);
                } else {
                  delete messageEl._typingTimeout;
                }
              };
              type();
            }
          }
        });
      });
    });
  </script>

  <style>
    #bg-gradient {
      background: linear-gradient(135deg, #0a0a0a, #121212, #1a1a1a, #0f0f0f);
      background-size: 400% 400%;
    }
  </style>

  <script>
    // Load GSAP via CDN
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';
    s.onload = () => {
      const st = document.createElement('script');
      st.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js';
      st.onload = () => {
        const { gsap, ScrollTrigger } = window;
        if (!gsap || !ScrollTrigger) return;
        gsap.registerPlugin(ScrollTrigger);

        const bg = document.getElementById('bg-gradient');
        if (bg) {
          gsap.to(bg, {
            backgroundPosition: '100% 100%',
            ease: 'none',
            scrollTrigger: {
              trigger: 'main',
              start: 'top top',
              end: 'bottom bottom',
              scrub: true,
            }
          });
        }

        // Scatter the cards in left to right on load. Deliberately NOT
        // ScrollTrigger.batch: batching ties the tween to a scroll position, so any
        // card already past its start when ScrollTrigger first measured would either
        // fire instantly or, if the batch never resolved, sit at the `from` state
        // (invisible) until scrolled to and then snap. That is exactly what happened
        // -- only the first card animated properly. A load-in sequence has no scroll
        // dependency, so it is a single timeline instead.
        //
        // The grid is row-major in the DOM, so a plain index stagger already walks
        // each row left to right and then drops to the next one.
        //
        // Opacity, brightness and saturation all rise together, no translate: a y
        // offset during the fade shifts the card's own drop shadow out of alignment
        // with the grid, which is visible on a layout this regular. Filtering the
        // whole card also has to live on the card rather than its children, because
        // a filter on a parent creates a containing block for any fixed-position
        // descendant -- the chip hovers and the gallery both depend on that.
        const cards = gsap.utils.toArray('main.site-main > *');
        if (cards.length === 0) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        // No willChange here. Promoting all 25 cards to their own composited layer
        // made the browser skip the paint-level interpolation, so opacity jumped
        // straight to its final value on every card except the first and only the
        // filter read as animating. The tween is short and the cards are simple
        // enough that the layer promotion costs more than it saves.
        //
        // Suppress every filter transition on the cards for the length of the
        // entrance. The site header carries `transition: filter 0.3s ease` for its
        // nav hue-shift, and that ease also applies to the tween's own filter
        // writes -- so a 0.3s transition was overriding the 0.5s tween and snapping
        // cards to their final value. Class-based rather than per-element so the
        // browser matches it once instead of recalculating transitions on 25 nodes.
        document.documentElement.classList.add('cards-entering');

        const contentNodes = cards.map((card) => Array.from(card.children));

        const tl = gsap.timeline({ delay: 1 });

        cards.forEach((card, i) => {
          tl.fromTo(card,
            { opacity: 0, filter: 'brightness(0) saturate(0)' },
            { opacity: 1, filter: 'brightness(1) saturate(1)', duration: 1.2, ease: 'power1.out' },
            i * 0.3
          );

          const content = contentNodes[i];
          if (content.length > 0) {
            tl.fromTo(content,
              { opacity: 0 },
              { opacity: 1, duration: 0.8, ease: 'power1.out' },
              2 + i * 0.3
            );
          }
        });

        tl.eventCallback('onComplete', () => {
          gsap.set(cards, { clearProps: 'filter' });
          document.documentElement.classList.remove('cards-entering');
        });
      };
      document.head.appendChild(st);
    };
    document.head.appendChild(s);
  </script>
  <div id="cursor-ball"></div>
  <script>
    const ball = document.getElementById('cursor-ball');
    if (ball) {
      let targetX = window.innerWidth / 2;
      let targetY = window.innerHeight / 2;
      let currentX = targetX;
      let currentY = targetY;
      const ease = 0.01;
      window.addEventListener('pointermove', (e) => {
        targetX = e.clientX;
        targetY = e.clientY;
      });
      function animate() {
        currentX += (targetX - currentX) * ease;
        currentY += (targetY - currentY) * ease;
        ball.style.left = currentX + 'px';
        ball.style.top = currentY + 'px';
        requestAnimationFrame(animate);
      }
      animate();
    }
    // Sticky hover on click
    let lockedEl = null;
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('button, a');
      if (btn) {
        if (lockedEl) lockedEl.classList.remove('is-hover-locked');
        lockedEl = btn;
        btn.classList.add('is-hover-locked');
      }
    });
    window.addEventListener('pointermove', () => {
      if (lockedEl) {
        lockedEl.classList.remove('is-hover-locked');
        lockedEl = null;
      }
    });
  </script>
