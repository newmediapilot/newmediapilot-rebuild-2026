  build: ['to top', '#33400f', '#2a2a1a', '#1c2408'],
  'accessibility-security': ['to top', '#4c1a28', '#2a1a3a', '#2b0d15'],
  // Portfolio cards.
  wrea: ['145deg', '#1b3a4b', '#16404a', '#0b1a24'],
  remedy: ['115deg', '#3d1636', '#2a1a3a', '#1a0b1c'],
  oakcountry: ['160deg', '#43301a', '#2a331a', '#1d1409'],
  novo: ['125deg', '#123a34', '#123a20', '#07191a'],
  mazda: ['100deg', '#3a1420', '#2a1a2a', '#180810'],
  klodge: ['150deg', '#16303f', '#1a3020', '#091820'],
  homelife: ['135deg', '#1c3320', '#1c2a3a', '#0a1710'],
  ccambridge: ['95deg', '#3b2a10', '#332a1a', '#1a1206'],
  archmedia: ['170deg', '#231a44', '#1a2a3a', '#0f0b20'],
  'stella-mccartney': ['120deg', '#3b2450', '#3a2020', '#1b0f26'],
  workopolis: ['140deg', '#1a2440', '#1a2a3a', '#0a0f1d'],
}

// Cards whose colour comes from a texture class rather than a gradient, so they
// are deliberately absent from `cardColors`: the intro panel takes `.stripes-rust`,
// and CMS and Web Frameworks take `.stripes-panel` with their own two tones.
const PATTERN_CARD_IDENTS = new Set(['intro-panel', 'cms', 'frameworks'])

// Static cards in the page that are not part of the projects or skill groups.
const STATIC_CARD_IDENTS = ['site-header', 'professional-skills', 'footer-brands', 'footer-websites']

// Build-time guard. A card with no colour would fall through to the shared gray
// default and read as a bug against its neighbours, so the build fails and names
// the offenders instead. Covers all three sources of cards, not just the projects:
// a new skill group or a renamed ident is caught the same way.
const uncolored = [
  ...STATIC_CARD_IDENTS,
  ...skillGroups.map((group) => group.ident),
  ...projects.map((project) => project.key),
].filter((ident) => !PATTERN_CARD_IDENTS.has(ident) && !cardColors[ident])

if (uncolored.length > 0) {
  throw new Error(`cardColors is missing an entry for: ${[...new Set(uncolored)].join(', ')}`)
}

// Build-time guard: every entry must carry a mid stop. A two-stop row would still
// build and still render, just without the complementary blend, which is the
// failure that is easiest to reintroduce by accident when adding a card.
const noMid = Object.entries(cardColors)
  .filter(([, entry]) => entry.length < 4)
  .map(([ident]) => ident)

if (noMid.length > 0) {
  throw new Error(`cardColors needs a mid stop (3 colours) for: ${noMid.join(', ')}`)
}

const gradStyle = (ident) => {
  const [angle, top, mid, bottom] = cardColors[ident]
  return `--grad-angle:${angle};--grad-top:${top};--grad-mid:${mid};--grad-bottom:${bottom}`
}

// Brands & Agencies sits inside the skills grid, immediately above Front-end.
// A marker entry in the same list keeps the skill groups to a single pass.
const BRANDS_ANCHOR = 'brands'
const skillRows = skillGroups.flatMap((group) =>
  group.ident === 'front-end' ? [{ ident: BRANDS_ANCHOR }, group] : [group]
)
