const intro =
  'I have spent decades building things on the Internet, and I enjoy the work. I have worked in real estate, advertising and marketing, games and entertainment, and the public sector. I work pragmatically: the next useful step, not the most impressive one. I stay at it when something is difficult or unfinished, because good outcomes come from steady effort rather than one big moment. I keep an eye on what is changing and think\u00A0ahead.'

const rows = [
  { name: 'World Real Estate Association Portal', href: '#', image: '/uploads/preview-wrea.png', alt: 'Preview', position: 'center' },
  { name: 'Remedy Design Portfolio Website', href: '#', image: '/uploads/preview-remedy.png', alt: 'Preview', position: 'center' },
  { name: 'Oak & Country Samples', href: '#', image: '/uploads/preview-oakcountry.png', alt: 'Preview', position: 'center' },
  { name: 'Novo Nordisk Sales Module', href: '#', image: '/uploads/preview-novo.png', alt: 'Preview', position: 'center' },
  { name: 'Mazda SkyDrive Module', href: '#', image: '/uploads/preview-mazda.png', alt: 'Preview', position: 'center' },
  { name: 'Killarney Lodge Website', href: '#', image: '/uploads/preview-klodge.png', alt: 'Preview', position: 'center' },
  { name: 'HomeLife Realty Website', href: '#', image: '/uploads/preview-homelife.png', alt: 'Preview', position: 'center' },
  { name: 'CrossFit Cambridge Website', href: '#', image: '/uploads/preview-ccambridge.png', alt: 'Preview', position: 'center' },
  { name: 'Architectural Media Website', href: '#', image: '/uploads/preview-archmedia.png', alt: 'Preview', position: 'center' },
]

const websites = [
  { label: 'HomeLife Realty Website', href: 'https://www.homelife.ca/' },
  { label: 'World Real Estate Association Portal', href: 'https://thewrea.com/' },
  { label: 'CrossFit Cambridge Website', href: 'https://crossfitcambridge.ca/' },
  { label: 'Killarney Lodge Website', href: 'https://killarneylodge.com/' },
]

const recentWebsiteLabels = new Set(websites.map(w => w.label));
const websiteUrlMap = Object.fromEntries(websites.map(w => [w.label, w.href]));

const slug = (value) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '')

const skillGroups = [
  {
    ident: 'frameworks',
    label: 'Web Frameworks',
    note: 'Builds websites and web applications',
    skills: ['React', 'Angular', 'Vue', 'Astro', 'Symfony', 'Redux'],
  },
  {
