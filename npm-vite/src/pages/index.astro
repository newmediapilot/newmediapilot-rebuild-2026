    <section data-ident="intro-panel" class="page rounded-panel p-8 sm:p-12 bg-transparent stripes-rust shadow-[0_20px_40px_-20px_#000] h-[36vh]">
      <p data-ident="intro-paragraph" class="text-shadow-hard font-serif text-base leading-relaxed sm:text-lg">{intro}</p>
    </section>

    <section data-ident="professional-skills" class="page rounded-panel p-4 sm:p-6 shadow-[0_20px_40px_-20px_#000] h-[36vh]">
      <h2 data-ident="professional-skills-heading" class="text-2xl font-extrabold uppercase tracking-widest sm:text-3xl">Professional skills</h2>
      <div data-ident="professional-skills-list" class="mt-6 flex flex-wrap gap-2">
        {
          professional.map((skill) => (
            <div class="flex items-center gap-2 rounded-full border border-white/30 px-3 py-1.5 text-xs sm:text-sm">
              <span class="size-3 rounded-full border border-white/60" aria-hidden="true" />
              <span>{skill}</span>
            </div>
          ))
        }
      </div>
    </section>

    {
      skillGroups.map((group) => (
        <section data-ident={`skill-group-${group.ident}`} class="page rounded-panel p-4 sm:p-6 shadow-[0_20px_40px_-20px_#000] h-[36vh]">
          <h3 data-ident={`skill-group-${group.ident}-heading`} class="font-serif text-xl font-bold uppercase tracking-wider text-white sm:text-2xl">
            {group.label}
          </h3>
          <p data-ident={`skill-group-${group.ident}-note`} class="mt-0 -mt-1 mb-3 text-sm leading-relaxed text-white/60 sm:text-base line-clamp-2">
            {group.note}
          </p>
          {group.ident === 'ai' ? (
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <li>
                  <div data-chip class="group relative flex cursor-pointer items-center gap-2 rounded-md border border-white/30 bg-black px-3 py-1.5 text-xs sm:text-sm" data-note={group.note} data-desc={aiDescriptions[skill] || ''}>
                    <span>{skill}</span>
                    <button class="flex h-5 w-5 items-center justify-center rounded border border-white/20 bg-black/40 text-[10px] text-white/60 transition hover:text-white" aria-label={`More about ${skill}`}>
                      ?
                    </button>
                  </div>
                </li>
              ))}
            </ul>
            <div data-ai-message class="mt-3 hidden text-xs text-white/70"></div>
          ) : group.ident === 'frameworks' ? (
            <div class="mt-4 grid grid-cols-3 gap-3 sm:gap-4">
              {group.skills.map((skill) => {
                const iconMap = {
                  'React': 'react',
                  'Angular': 'angular',
                  'Vue': 'vuedotjs',
                  'Astro': 'astro',
                  'Symfony': 'symfony',
                  'Redux': 'redux'
                };
                const urlMap = {
                  'React': 'https://react.dev',
                  'Angular': 'https://angular.io',
                  'Vue': 'https://vuejs.org',
                  'Astro': 'https://astro.build',
                  'Symfony': 'https://symfony.com',
                  'Redux': 'https://redux.js.org'
                };
                const icon = iconMap[skill] || 'react';
                const url = urlMap[skill] || '#';
                return (
                  <a href={url} target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center justify-center rounded-md border border-white/30 bg-black p-3 text-center transition duration-200 hover:bg-black/80">
                    <img src={`https://cdn.simpleicons.org/${icon}/ffffff`} alt={skill} class="mb-2 h-8 w-8 sm:h-10 sm:w-10 transition-transform duration-200 group-hover:scale-110" />
                    <span class="text-[10px] sm:text-xs">{skill}</span>
                  </a>
                );
              })}
            </div>
          ) : group.ident === 'cms' ? (
            <div class="mt-2 overflow-auto">
              <table class="w-full table-fixed border-collapse text-[11px] sm:text-xs">
                <thead>
                  <tr class="border-b border-white/20">
                    <th class="p-1.5 font-semibold uppercase tracking-wider text-left">System</th>
                    <th class="p-1.5 font-semibold uppercase tracking-wider text-center">Authored</th>
                    <th class="p-1.5 font-semibold uppercase tracking-wider text-center">Integrated</th>
                    <th class="p-1.5 font-semibold uppercase tracking-wider text-center">Extended</th>
                  </tr>
                </thead>
                <tbody>
                  {group.skills.map((skill) => {
                    const row = cmsMapping[skill] || { authored: '—', integrated: '—', extended: '—', url: '' };
                    const Icon = (val) => val === 'yes' ? '✓' : val === 'no' ? '✗' : '—';
                    return (
                      <tr class="border-b border-white/10">
                        <td class="p-1.5 align-top text-left">
                          {row.url ? <a href={row.url} target="_blank" rel="noopener noreferrer" class="hover:underline">{skill}</a> : skill}
                        </td>
                        <td class="p-1.5 align-top text-center">{Icon(row.authored)}</td>
                        <td class="p-1.5 align-top text-center">{Icon(row.integrated)}</td>
                        <td class="p-1.5 align-top text-center">{Icon(row.extended)}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <li>
                  <div data-chip class="group relative flex cursor-pointer items-center gap-2 rounded-md border border-white/30 bg-black px-3 py-1.5 text-xs sm:text-sm" data-note={group.note} data-desc={skillDescriptions[skill] || ''}>
                    <span>{skill}</span>
                    <button class="flex h-5 w-5 items-center justify-center rounded border border-white/20 bg-black/40 text-[10px] text-white/60 transition hover:text-white" aria-label={`More about ${skill}`}>
                      ?
                    </button>
                  </div>
                </li>
              ))}
            </ul>
            <div data-ai-message class="mt-3 hidden text-xs text-white/70"></div>
          )}
        </section>
      ))
    }

    {
      rows.map((row) => (
        <section data-ident={`recent-work-${slug(row.name)}`} class="page rounded-panel p-4 sm:p-6 shadow-[0_20px_40px_-20px_#000] h-[36vh] grid grid-cols-[1fr_1fr] gap-4 items-stretch overflow-hidden">
          <div class="overflow-hidden rounded-lg">
            <Image src={row.image} alt={row.alt} class="h-full w-full object-cover scale-[1.08]" style={`object-position: ${row.position}`} />
          </div>
          <div class="flex flex-col justify-center">
            <h3 class="font-serif text-lg sm:text-xl">{row.name}</h3>
            <p class="mt-2 text-xs text-white/70 sm:text-sm">Ongoing client work with focus on performance and content systems.</p>
            <div class="mt-3 flex items-center gap-3">
              <button class="text-xs underline decoration-white/40 underline-offset-4 hover:decoration-white">View gallery</button>
              {row.href && row.href !== '#' && (
                <a href={row.href} target="_blank" rel="noopener" class="text-xs underline decoration-white/40 underline-offset-4 hover:decoration-white">Launch website</a>
              )}
            </div>
          </div>
        </section>
      ))
    }

    <section data-ident="footer-websites" class="page rounded-panel p-4 sm:p-6 shadow-[0_20px_40px_-20px_#000] h-[36vh]">
      <h3 class="font-serif text-xl font-bold uppercase tracking-wider text-white sm:text-2xl">Recent websites</h3>
