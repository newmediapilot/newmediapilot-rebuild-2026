    [data-ident="footer-brands"] div::-webkit-scrollbar-track { background: transparent; }
    [data-ident="footer-brands"] div::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
    [data-ident="footer-brands"] div::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.35); }
    .scroll-snap-y { scroll-snap-type: y mandatory; }
    .scroll-snap-y .snap-start { scroll-snap-align: start; }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const chips = document.querySelectorAll('[data-chip]');
      chips.forEach(chip => {
        chip.addEventListener('click', (e) => {
          e.stopPropagation();
          const section = chip.closest('section');
          const allChips = section.querySelectorAll('[data-chip]');
          allChips.forEach(c => c.classList.remove('active'));
          const isChecked = chip.classList.contains('inverted');
          const btn = chip.querySelector('button');
          if (isChecked) {
            chip.classList.remove('inverted');
            if (btn) btn.textContent = '?';
            const messageEl = section.querySelector('[data-ai-message]');
            if (messageEl) { messageEl.classList.add('hidden'); messageEl.textContent = ''; }
          } else {
            chip.classList.add('inverted');
            chip.classList.add('active');
            if (btn) btn.textContent = '✓';
            const messageEl = section.querySelector('[data-ai-message]');
            if (messageEl) {
              messageEl.classList.remove('hidden');
              const desc = chip.dataset.desc || chip.dataset.note || '';
              let i = 0;
              messageEl.textContent = '';
              const speed = 18;
              const type = () => {
                if (i <= desc.length) {
                  messageEl.textContent = desc.slice(0, i);
                  i++;
                  setTimeout(type, speed);
                }
              };
              type();
            }
          }
        });
      });
    });
  </script>
</Base>
