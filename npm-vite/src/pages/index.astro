// Shuffled rather than alphabetised, so the chips don't read as a data table.
// Seeded (mulberry32) instead of Math.random() because this runs at build time:
// an unseeded shuffle would reorder the chips on every build, producing a diff
// with no source change and a different page each deploy. Change SEED to reshuffle.
const BRAND_SEED = 0x9e3779b9

const shuffledBrands = (() => {
  let s = BRAND_SEED
  const rand = () => {
    s = (s + 0x6d2b79f5) | 0
    let t = Math.imul(s ^ (s >>> 15), 1 | s)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
  const out = [...brands]
  for (let i = out.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1))
    ;[out[i], out[j]] = [out[j], out[i]]
  }
  return out
})()

