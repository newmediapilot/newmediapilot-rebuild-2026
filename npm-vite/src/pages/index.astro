    label: 'Databases',
    note: 'Stores and queries application data',
    skills: ['SQL', 'NoSQL', 'MongoDB', 'DynamoDB', 'SQLite'],
  },
  {
    ident: 'cloud',
    label: 'Cloud & infrastructure',
    note: 'Deploys, hosts and scales applications',
    skills: [
      'AWS',
      'Lambda',
      'S3',
      'CloudFront',
      'Route 53',
      'EC2',
      'Elastic Beanstalk',
      'Load balancers',
      'Lightsail',
      'Netlify',
      'Vercel',
