// The key is the project identity shared by the card image
// (uploads/preview-<key>.png) and its gallery shots
// (uploads/image-preview-<key>-<n>.png). Card names slugify to something else
// entirely, so the key is what ties a card to its gallery.
const projects = [
  { key: 'wrea', name: 'World Real Estate Association' },
  { key: 'remedy', name: 'Remedy Design' },
  { key: 'oakcountry', name: 'Oak & Country Samples' },
  { key: 'novo', name: 'Novo Nordisk' },
  { key: 'mazda', name: 'Mazda SkyDrive' },
  { key: 'klodge', name: 'Killarney Lodge' },
  { key: 'homelife', name: 'HomeLife Realty' },
  { key: 'ccambridge', name: 'CrossFit Cambridge' },
  { key: 'archmedia', name: 'Architectural Media' },
  { key: 'stella-mccartney', name: 'Stella McCartney' },
  { key: 'workopolis', name: 'Workopolis' },
]

// Per-project card blurbs, keyed by the same project key. Sparse on purpose:
// any project without an entry keeps the shared fallback line below, so the
// ten cards you have not written copy for yet are unchanged.
const projectDescriptions = {
  wrea: 'Real estate portal for associate members with payment system and identity integration',
  remedy: 'A dynamically animated website with portfolio samples and client roster',
  oakcountry: 'An AI generated concept for an imaginary golf course',
  novo: 'A sales module for field presentations pertaining to insulin delivery',
  mazda: 'Interactive screen presentation outlining a brand new engine',
  klodge: 'Immersive marketing site clearly defining this all inclusive premium resort',
  homelife: 'Marketing website with offering, contact information and a searchable roster',
  ccambridge: 'Fitness site with pricing, booking, galleries and mission statement',
  archmedia: 'A multipage dynamic animated site with offering of services',
  workopolis: 'Preliminary module samples for a potential product',
  'stella-mccartney': 'Initial design tests on a potential product',
}

// Card thumbnail path. Stella's thumbnail is `preview-stella.png`, not
// `preview-stella-mccartney.png`. Work around the mismatch with a one-line alias.
const CARD_THUMB = (key) =>
  key === 'stella-mccartney' ? '/uploads/preview-stella.png' : `/uploads/preview-${key}.png`

const rows = projects.map((project) => ({
  ...project,
  href: '#',
  image: CARD_THUMB(project.key),
  alt: 'Preview',
  position: 'center',
}))

const websites = [
  { label: 'Killarney Lodge', href: 'https://killarneylodge.com/' },
  { label: 'HomeLife Realty', href: 'https://www.homelife.ca/' },
  { label: 'CrossFit Cambridge', href: 'https://crossfitcambridge.ca/' },
  { label: 'World Real Estate Association', href: 'https://thewrea.com/' },
]

// Tools used day to day, shown as a plain list -- these are the applications behind
// the work, not client projects, so they carry no outbound links.
const software = [
  'Adobe Creative Cloud',
  'Figma',
  'Sketch',
  'Microsoft Office Suite',
  'Keynote',
  'IntelliJ',
  'VS Code',
  'GitHub Desktop',
]

const recentWebsiteLabels = new Set(websites.map(w => w.label));
const websiteUrlMap = Object.fromEntries(websites.map(w => [w.label, w.href]));

const slug = (value) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '')

// Every project now has its own blurb, so a missing one is a gap in the copy rather
// than an intentional omission. Same reasoning as the `cardColors` guard below: fail
// the build and name the project, instead of silently shipping the shared fallback
// line on one card among eleven bespoke ones.
const undescribed = projects.filter((project) => !projectDescriptions[project.key])
if (undescribed.length > 0) {
  throw new Error(
    `projectDescriptions is missing an entry for: ${undescribed.map((project) => `${project.key} (${project.name})`).join(', ')}`
  )
}

// Gallery shots are discovered at build time, so dropping a new image-*.png into
// public/uploads is enough to populate that project's gallery -- there is no list
// to maintain here. A key with no matching project is simply never looked up.
// The virtual module hands over bare filenames; public/ serves the bytes itself.
const shotsByKey = {}
for (const file of galleryShots) {
  const match = file.match(/^image-preview-(.+)-(\d+)\.png$/)
  if (!match) continue
  ;(shotsByKey[match[1]] ??= []).push({ index: Number(match[2]), url: `/uploads/${file}` })
}
for (const shots of Object.values(shotsByKey)) {
  shots.sort((a, b) => a.index - b.index)
}

const galleries = Object.fromEntries(
  rows.map((row) => [
    slug(row.name),
    {
      name: row.name,
      images: (shotsByKey[row.key] ?? []).map((shot) => shot.url),
    },
  ])
)

