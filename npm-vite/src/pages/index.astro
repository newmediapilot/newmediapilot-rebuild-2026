    skills: [
      'AI agents',
      'Agentic coding',
      'Automation',
      'OpenCode',
      'LM Studio',
      'Google ADK',
      'OpenAI API',
      'Hugging Face',
      'Local models',
      'GPT OSS',
      'DeepSeek',
      'Nemotron',
      'GLM',
      'Gemma',
      'Prompt engineering',
    ],
  },
    {
      ident: 'cms',
      label: 'Content Management Systems',
