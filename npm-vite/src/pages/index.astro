    .recent-work > * {
      position: relative;
      z-index: 1;
    }

    /* The image cell is stretched by the grid, so its width and height are both
       known. Sizing from min(100cqw, 100cqh) keeps the card exactly 1:1 at every
       viewport -- a plain aspect-ratio + max-width clamp collapses into a
       portrait box (and crops the image) once the column is narrower than tall. */
    /* Framework tile hover backdrop. The GIF is declared only on :hover so the
       browser fetches ~6MB of animation on first hover instead of on page load.
       brightness and opacity compound against the black tile, so both have to stay
       well above zero or the result is invisible. */
    .framework-tile::before {
      content: "";
      position: absolute;
      inset: 0;
      background-position: center;
      background-size: cover;
      filter: grayscale(1) brightness(0.6) contrast(1.1);
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    .framework-tile:hover::before {
      background-image: var(--tile-gif);
      opacity: 0.5;
    }

    /* Follows the glyph's alpha shape, so unlike box-shadow it does not draw a
       rectangle. Sits under the icon and reads once the hover backdrop lifts. */
    .framework-logo {
      filter: drop-shadow(0 6px 5px rgba(0, 0, 0, 1)) drop-shadow(0 3px 2px rgba(0, 0, 0, 0.95)) drop-shadow(0 1px 0 rgba(0, 0, 0, 0.9));
    }

    .card-figure {
      container-type: size;
    }
    .card-image {
      width: min(100cqw, 100cqh);
      height: min(100cqw, 100cqh);
      flex: none;
      /* Positive offsets keep the inset shadow on the inner top-left edges only.
         Reads stronger on hover, when the brightness filter lifts. */
      box-shadow: inset 6px 6px 14px rgba(0, 0, 0, 0.45);
    }
    /* Stacked cards have no grid cell to stretch, so there is no resolved block
       size for a `size` container to measure against. Switching to `inline-size`
       derives the square from the column width alone, which is stable once the
       height comes from content. */
    @media (max-width: 900px) {
      .card-figure { container-type: inline-size; }
      .card-image { width: 100cqw; height: 100cqw; }
    }

    /* The chips are plain divs with no role or tabindex, so none of the pointer
       selectors in global.css match them. Declared here instead of adding a role,
       since they carry no action for a pointer to promise. */
    /* The chip is the positioning context: the gradient lives on a ::before
       pinned to its padding box, so it sits behind the dot and the label without
       needing to know their sizes. Those two then lift above it with z-index. */
    .professional-chip {
      transition: border-color 0.2s ease;
      cursor: pointer;
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    /* 45deg gives the diagonal banding. The bands alternate between two tones and
       slide sideways, which only reads as movement because background-size is
       wider than the box -- at 100% a translated background would simply clip. */
    .professional-chip::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      opacity: 0;
      background-image: repeating-linear-gradient(
        135deg,
        rgba(191, 77, 40, 0.75) 0px,
        rgba(191, 77, 40, 0.75) 14px,
        rgba(122, 49, 20, 0.75) 14px,
        rgba(122, 49, 20, 0.75) 28px
      );
      background-size: 300% 300%;
      background-position: 100% 50%;
      /* Fast out. The hover rule below overrides this with the slower duration,
         so the easing can differ per direction without a second element. */
      transition: opacity 120ms ease-out;
    }
    .professional-chip:hover::before,
    .professional-chip:focus-visible::before {
      opacity: 1;
      /* Long cycle: the gradient drifts rather than visibly scrolls. */
      animation: chip-gradient-slide 9s linear infinite;
      transition: opacity 300ms ease-in;
    }
    /* Isolated on ::before so the moving gradient cannot re-trigger the reveal
       transition on every repaint. Runs right-to-left to match the reading
       direction of the keyframe, so the banding travels back the other way. */
    @keyframes chip-gradient-slide {
      from { background-position: 100% 50%; }
      to   { background-position: 0% 50%; }
    }
    /* The label sits over a moving gradient, so it takes the same hard black
       shadow the intro paragraph uses to stay readable. */
    .professional-chip > span:not(:first-child) {
      position: relative;
      z-index: 1;
      text-shadow: 2px 2px 0 #000;
    }
    .professional-chip > span:first-child {
      position: relative;
      z-index: 1;
    }
    /* Reduced motion: keep the reveal, drop the slide. A looping background
       animation is exactly the kind of large-area motion this setting targets. */
    @media (prefers-reduced-motion: reduce) {
      .professional-chip:hover::before,
      .professional-chip:focus-visible::before {
        animation: none;
      }
    }
    .professional-chip:hover {
      border-color: rgba(255,255,255,0.6);
    }
    .skill-chip { transition: border-color 0.2s ease; }
    .skill-chip:hover {
      border-color: rgba(255,255,255,0.6);
    }
    .site-header {
      transition: filter 0.3s ease;
    }
    .site-header {
      transition: filter 0.3s ease;
    }
    /* Nav children: 1 = button, 2 = LinkedIn, 3 = GitHub, 4 = Download CV */
    .site-header:has(nav a:nth-child(2):hover) {
      filter: hue-rotate(10deg);
    }
    .site-header:has(nav a:nth-child(3):hover) {
      filter: hue-rotate(20deg);
    }
    .site-header:has(nav a:nth-child(4):hover) {
      filter: hue-rotate(30deg);
    }
    /* pointer-events was disabled on the whole panel, which suppressed :hover on
       every chip inside it -- no border flash, no fast spin, no pointer cursor,
       since hover never reached them. Restored so the chip hovers work. */
    .is-hover-locked {
      filter: brightness(1.3) saturate(1.2);
      outline: 2px solid rgba(255,255,255,0.6);
      outline-offset: 2px;
    }
    @keyframes hue-rotate-slow {
      from { filter: hue-rotate(0deg); }
      to { filter: hue-rotate(360deg); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    [data-ident="site-header"] {
      animation: hue-rotate-slow 5s linear infinite;
    }
    /* Static grid: the design-system .page forces a fixed 400/500px height, which
       would leave dead space under the list. Declared after that rule so it wins
       on equal specificity. */
    .footer-brands {
      height: auto !important;
      min-height: 0 !important;
      position: relative;
      overflow: hidden;
      background: transparent !important;
    }
    /* Mirrors .skill-group::before. Duplicated rather than added via the
       `skill-group` class because that selector also matches
       `section.page.skill-group { min-height: 360px }` above, which would
       override the auto height this panel needs. */
    .footer-brands::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #000508 0%, #000b18 100%);
      filter: contrast(170%) brightness(400%);
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.5'/></svg>");
      background-blend-mode: overlay;
      opacity: 0.4;
      z-index: 0;
    }
    .footer-brands > * { position: relative; z-index: 1; }
    #cursor-ball {
      position: fixed;
      left: 0;
      top: 0;
      width: 360vw;
      height: 360vh;
      pointer-events: none;
      mix-blend-mode: soft-light;
      background: radial-gradient(circle, rgba(255,255,255,0.35) 0%, rgba(255,255,255,0) 70%);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      z-index: 9999;
    }
</style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const chips = document.querySelectorAll('[data-chip]');
      chips.forEach(chip => {
        chip.addEventListener('click', (e) => {
          e.stopPropagation();
          const section = chip.closest('section');
          const allChips = section.querySelectorAll('[data-chip]');
          allChips.forEach(c => c.classList.remove('active'));
          const isChecked = chip.classList.contains('inverted');
          const btn = chip.querySelector('button');
          const messageEl = section.querySelector('[data-ai-message]');
          if (messageEl && messageEl._typingTimeout) {
            clearTimeout(messageEl._typingTimeout);
            delete messageEl._typingTimeout;
          }
          if (isChecked) {
            chip.classList.remove('inverted');
            if (btn) btn.textContent = '?';
            if (messageEl) { messageEl.classList.add('hidden'); messageEl.textContent = ''; }
          } else {
            chip.classList.add('inverted');
            chip.classList.add('active');
            if (btn) btn.textContent = '✓';
            if (messageEl) {
              messageEl.classList.remove('hidden');
              const desc = chip.dataset.desc || chip.dataset.note || '';
              let i = 0;
              messageEl.textContent = '';
              const speed = 18;
              const type = () => {
                if (i <= desc.length) {
                  messageEl.textContent = desc.slice(0, i);
                  i++;
                  messageEl._typingTimeout = setTimeout(type, speed);
                } else {
                  delete messageEl._typingTimeout;
                }
              };
              type();
            }
          }
        });
      });
    });
  </script>

  <style>
    #bg-gradient {
      background: linear-gradient(135deg, #0a0a0a, #121212, #1a1a1a, #0f0f0f);
      background-size: 400% 400%;
    }
  </style>

  <script>
    // Load GSAP via CDN
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';
    s.onload = () => {
      const st = document.createElement('script');
      st.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js';
      st.onload = () => {
        const bg = document.getElementById('bg-gradient');
        if (!bg || !window.gsap || !window.ScrollTrigger) return;
        window.gsap.registerPlugin(window.ScrollTrigger);
        window.gsap.to(bg, {
          backgroundPosition: '100% 100%',
          ease: 'none',
          scrollTrigger: {
            trigger: 'main',
            start: 'top top',
            end: 'bottom bottom',
            scrub: true,
          }
        });
      };
      document.head.appendChild(st);
    };
    document.head.appendChild(s);
  </script>
  <div id="cursor-ball"></div>
  <script>
    const ball = document.getElementById('cursor-ball');
    if (ball) {
      let targetX = window.innerWidth / 2;
      let targetY = window.innerHeight / 2;
      let currentX = targetX;
      let currentY = targetY;
      const ease = 0.01;
      window.addEventListener('pointermove', (e) => {
        targetX = e.clientX;
        targetY = e.clientY;
      });
      function animate() {
        currentX += (targetX - currentX) * ease;
        currentY += (targetY - currentY) * ease;
        ball.style.left = currentX + 'px';
        ball.style.top = currentY + 'px';
        requestAnimationFrame(animate);
      }
      animate();
    }
    // Sticky hover on click
    let lockedEl = null;
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('button, a');
      if (btn) {
        if (lockedEl) lockedEl.classList.remove('is-hover-locked');
        lockedEl = btn;
        btn.classList.add('is-hover-locked');
      }
    });
    window.addEventListener('pointermove', () => {
      if (lockedEl) {
        lockedEl.classList.remove('is-hover-locked');
        lockedEl = null;
      }
    });
  </script>
</Base>
