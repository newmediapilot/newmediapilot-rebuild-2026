  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const chips = document.querySelectorAll('[data-chip]');
      chips.forEach(chip => {
        chip.addEventListener('click', (e) => {
          e.stopPropagation();
          const section = chip.closest('section');
          const allChips = section.querySelectorAll('[data-chip]');
          allChips.forEach(c => c.classList.remove('active'));
          const isChecked = chip.classList.contains('inverted');
          const btn = chip.querySelector('button');
          const messageEl = section.querySelector('[data-ai-message]');
          if (messageEl && messageEl._typingTimeout) {
            clearTimeout(messageEl._typingTimeout);
            delete messageEl._typingTimeout;
          }
          if (isChecked) {
            chip.classList.remove('inverted');
            if (btn) btn.textContent = '?';
            if (messageEl) { messageEl.classList.add('hidden'); messageEl.textContent = ''; }
          } else {
            chip.classList.add('inverted');
            chip.classList.add('active');
            if (btn) btn.textContent = '✓';
            if (messageEl) {
              messageEl.classList.remove('hidden');
              const desc = chip.dataset.desc || chip.dataset.note || '';
              let i = 0;
              messageEl.textContent = '';
              const speed = 18;
              const type = () => {
                if (i <= desc.length) {
                  messageEl.textContent = desc.slice(0, i);
                  i++;
                  messageEl._typingTimeout = setTimeout(type, speed);
                } else {
                  delete messageEl._typingTimeout;
                }
              };
              type();
            }
          }
        });
      });
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('contact-card-modal');
      const openBtn = document.querySelector('[data-open-contact-card]');
      const closeBtn = document.querySelector('[data-close-contact-card]');
      const modalContent = modal?.querySelector('.page');
      if (openBtn && modal) {
        openBtn.addEventListener('click', () => {
          modal.classList.remove('hidden');
          requestAnimationFrame(() => {
            modal.classList.add('is-open');
            modalContent?.classList.add('is-open');
          });
        });
      }
      const closeModal = () => {
        modal?.classList.remove('is-open');
        modalContent?.classList.remove('is-open');
        setTimeout(() => modal?.classList.add('hidden'), 300);
      };
      if (closeBtn && modal) {
        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      }
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const alphabet = document.getElementById('brands-alphabet');
      const list = document.getElementById('brands-list');
      if (!alphabet || !list) return;
      const items = Array.from(list.querySelectorAll('li'));
      const buttons = Array.from(alphabet.querySelectorAll('button[data-letter]'));
      // gray out letters with no members
      const present = new Set(items.map(li => li.dataset.first));
      buttons.forEach(btn => {
        const letter = btn.dataset.letter;
        if (letter === 'all') return;
        if (!present.has(letter)) {
          btn.classList.add('opacity-30','pointer-events-none');
        }
      });
      let active = null;
      const setActive = (btn) => {
        buttons.forEach(b => {
          b.classList.remove('bg-white','text-black');
          b.classList.add('border-white/30','text-white/70');
        });
        if (btn) {
          btn.classList.add('bg-white','text-black');
          btn.classList.remove('border-white/30','text-white/70');
        }
      };
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const letter = btn.dataset.letter;
          if (btn.classList.contains('pointer-events-none')) return;
          if (letter === 'all') {
            active = null;
            items.forEach(li => li.classList.remove('hidden'));
            setActive(null);
            return;
          }
          if (active === letter) return;
          active = letter;
          items.forEach(li => {
            const first = li.dataset.first || '';
            li.classList.toggle('hidden', first !== letter);
          });
          setActive(btn);
        });
      });
    });
  </script>

