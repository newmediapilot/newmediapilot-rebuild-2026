  <script>
    // Load GSAP via CDN
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';
    s.onload = () => {
      const st = document.createElement('script');
      st.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js';
      st.onload = () => {
        const bg = document.getElementById('bg-gradient');
        if (!bg || !window.gsap || !window.ScrollTrigger) return;
        window.gsap.registerPlugin(window.ScrollTrigger);
        window.gsap.to(bg, {
          backgroundPosition: '100% 100%',
          ease: 'none',
          scrollTrigger: {
            trigger: 'main',
            start: 'top top',
            end: 'bottom bottom',
            scrub: true,
          }
        });
      };
      document.head.appendChild(st);
    };
    document.head.appendChild(s);
  </script>
  <div id="cursor-ball"></div>
  <script>
    const ball = document.getElementById('cursor-ball');
    if (ball) {
      let targetX = window.innerWidth / 2;
      let targetY = window.innerHeight / 2;
      let currentX = targetX;
      let currentY = targetY;
      const ease = 0.01;
      window.addEventListener('pointermove', (e) => {
        targetX = e.clientX;
        targetY = e.clientY;
      });
      function animate() {
        currentX += (targetX - currentX) * ease;
        currentY += (targetY - currentY) * ease;
        ball.style.left = currentX + 'px';
        ball.style.top = currentY + 'px';
        requestAnimationFrame(animate);
      }
      animate();
    }
    // Sticky hover on click
    let lockedEl = null;
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('button, a');
      if (btn) {
        if (lockedEl) lockedEl.classList.remove('is-hover-locked');
        lockedEl = btn;
        btn.classList.add('is-hover-locked');
      }
    });
    window.addEventListener('pointermove', () => {
      if (lockedEl) {
        lockedEl.classList.remove('is-hover-locked');
        lockedEl = null;
      }
    });
  </script>
